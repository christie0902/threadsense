# Python environments and generated files belong to each computer.
.venv*/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.cache/
.coverage
htmlcov/

# Ignore remnants of packages installed into the repository root.
/Lib/
/Include/
/pyvenv.cfg
/scripts/*.exe
/scripts/Activate.ps1
/scripts/activate
/scripts/activate.bat
/scripts/deactivate.bat

# Operating system metadata and local credentials.
.DS_Store
Thumbs.db
.env
.env.*
!.env.example

# Local retrieval index (rebuild with scripts/build_retrieval_index.py).
/.index/
