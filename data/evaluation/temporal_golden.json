{
 "version": "temporal-golden-v1",
 "recorded": "2026-10-30",
 "purpose": "Temporal precedence golden set: 15 controlled cases. Labels were written from the rules below before the evaluator existed and are not derived from the implementation. Sources here are evaluation material, never indexed into data/knowledge; the evaluator builds a separate throwaway snapshot per case.",
 "label_rules": {
  "baseline": "The source(s) whose rule applies to the question at as_of. Empty with decision ABSTAIN when the records cannot decide.",
  "temporal_status": {
   "NO_CONFLICT": "No competing source was ever applicable to the question at as_of in scope (not yet published or effective, unapproved draft, other project or batch, or not a directive).",
   "RESOLVED_BY_RECORD": "A competing source that is or was applicable in scope is overridden by recorded precedence (newer approved revision, recorded supersession, expiry).",
   "UNRESOLVED": "Recorded dates, approvals and supersession cannot decide, or the guidance leaves the question open."
  },
  "temporal_review_required": "True when a team lead must settle precedence or an open question before acting.",
  "documentation_update_target": "A published source that still states a rule the records show is no longer current (it should be corrected); null otherwise. A superseded revision kept as history is not a target.",
  "must_not_win": "Sources that would be a false override if chosen as the baseline.",
  "prepared_judgments": "Semantic inputs the drafting/grounding models would provide (which sources the draft cites on the question, which pairs state different rules, announcement relevance/directive, current-source agreement, open question). Labelled PREPARED; they never name the expected winner. A conflict is only declared between sources present in the bundle the draft saw."
 },
