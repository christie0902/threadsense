        "content": "{\n  \"schema_version\": 2,\n  \"candidate_group_id\": \"cluster_6b59d13144282285\",\n  \"project_id\": \"audio_multimodal\",\n  \"batch_id\": \"audio_batch_06\",\n  \"is_coherent\": true,\n  \"coherence_rationale\": \"The topics discuss similar issues regarding audio playback failures and the handling of tasks with no audio or loading issues.\",\n  \"topics\": [\n    {\n      \"topic_name\": \"Audio Playback Issues\",\n      \"member_ids\": [\n        \"member_22fa96f8f37e7ea4f79fd6fb\",\n        \"member_8ce5853bbd6b1a416c28b76f\",\n        \"member_e0275e7d53c557361ca40bd1\",\n        \"member_4e743fb698f42bc160fb10b9\",\n        \"member_943da52557c55ff31ee76f89\",\n        \"member_61f4987d5eb6b1ccb2894091\"\n      ],\n      \"conversation_kind\": \"DISCUSSION\",\n      \"shared_issue\": {\n        \"text\": \"The threads discuss issues related to audio playback failures, specifically whether tasks should be marked as Quarantine (QN) or assigned a quality score.\",\n        \"evidence\": [\n          {\n            \"member_id\": \"member_22fa96f8f37e7ea4f79fd6fb\",\n            \"message_id\": \"1790879994.000128\",\n            \"quote\": \"[Task review]\\nIssue: No audio at all — QN or bad score?\\nQuestion: what is the correct handling for this task?\"\n          },\n          {\n            \"member_id\": \"member_8ce5853bbd6b1a416c28b76f\",\n            \"message_id\": \"1790882197.000111\",\n            \"quote\": \"Player never loads, should I QN? I thought a workaround existed in the previous queue, but it is happening again.\"\n          },\n          {\n            \"member_id\": \"member_e0275e7d53c557361ca40bd1\",\n            \"message_id\": \"1790896012.001900\",\n            \"quote\": \"Audio won't play in LT; is this QN or a player issue? I thought a workaround existed in the previous queue, but it is happening again. (task ref AUDIO-6012)\"\n          },\n          {\n            \"member_id\": \"member_4e743fb698f42bc160fb10b9\",\n            \"message_id\": \"1790915374.000127\",\n            \"quote\": \"Task check: Clip is completely silent, but the waveform exists. QN or quality score? (task ref AUDIO-5374)\"\n          },\n          {\n            \"member_id\": \"member_943da52557c55ff31ee76f89\",\n            \"message_id\": \"1790920171.000109\",\n            \"quote\": \"Anyone else seeing this? Player never loads, should I QN? I thought a workaround existed in the previous queue, but it is happening again.\"\n          },\n          {\n            \"member_id\": \"member_61f4987d5eb6b1ccb2894091\",\n            \"message_id\": \"1790934294.000106\",\n            \"quote\": \"Audio won't play in LT; is this QN or a player issue? I thought a workaround existed in the previous queue, but it is happening again. (task ref AUDIO-4294)\"\n          }\n        ]\n      },\n      \"representative_question\": {\n        \"text\": \"Should tasks with audio playback failures be marked as Quarantine (QN) or assigned a quality score?\",\n        \"evidence\": [\n          {\n            \"member_id\": \"member_22fa96f8f37e7ea4f79fd6fb\",\n            \"message_id\": \"1790879994.000128\",\n            \"quote\": \"Question: what is the correct handling for this task?\"\n          }\n        ]\n      },\n      \"relevant_differences\": [\n        {\n          \"text\": \"Some threads discuss completely silent clips while others focus on playback issues where the player fails to load.\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_4e743fb698f42bc160fb10b9\",\n              \"message_id\": \"1790915374.000127\",\n              \"quote\": \"Clip is completely silent, but the waveform exists.\"\n            },\n            {\n              \"member_id\": \"member_8ce5853bbd6b1a416c28b76f\",\n              \"message_id\": \"1790882197.000111\",\n              \"quote\": \"Player never loads, should I QN?\"\n            }\n          ]\n        }\n      ],\n      \"open_questions\": [\n        {\n          \"text\": \"What is the definitive process for handling tasks with no audio or playback issues?\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_22fa96f8f37e7ea4f79fd6fb\",\n              \"message_id\": \"1790879994.000128\",\n              \"quote\": \"Question: what is the correct handling for this task?\"\n            }\n          ]\n        }\n      ],\n      \"supported_answers\": [],\n      \"uncertainties\": [\n        {\n          \"text\": \"There is no consensus on whether to mark tasks as Quarantine (QN) or assign a quality score.\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_22fa96f8f37e7ea4f79fd6fb\",\n              \"message_id\": \"1790879994.000128\",\n              \"quote\": \"QN or bad score?\"\n            }\n          ]\n        }\n      ]\n    }\n  ],\n  \"needs_review\": false,\n  \"review_reasons\": []\n}",
