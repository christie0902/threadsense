        "content": "{\"topics\":[{\"topic_name\":\"When a factual error is significant or major in response-preference evaluation\",\"member_ids\":[\"M01\",\"M02\",\"M03\"],\"shared_issue\":{\"text\":\"Members asked how to judge whether a factual error is significant or major, and replies consistently framed the decision around whether the incorrect fact is central to the original question or changes the answer a user would act on.\",\"evidence_ids\":[\"E001\",\"E003\",\"E006\",\"E002\",\"E005\",\"E007\",\"E008\"]},\"relevant_differences\":[{\"text\":\"One reply treats an incorrect date as central when it changes which event happened first.\",\"evidence_ids\":[\"E002\"]},{\"text\":\"Another reply gives the contrasting case that a year being off by one is less significant when the recommendation would not change.\",\"evidence_ids\":[\"E004\"]},{\"text\":\"A TL reply adds that the same wrong year can be minor in background context but major in a chronology task, so task context matters.\",\"evidence_ids\":[\"E008\"]}],\"inventory\":[{\"item_id\":\"I01\",\"evidence_id\":\"E001\",\"kind\":\"QUESTION\",\"answer_status\":null,\"question\":{\"status\":\"PARTIAL\",\"answer_item_ids\":[\"I02\"],\"resolution_confidence\":0.76,\"uncertainty_note\":{\"text\":\"The reply gives a centrality-based example but also says the original question is needed before deciding, so the general threshold remains incomplete.\",\"evidence_ids\":[\"E002\"]}}},{\"item_id\":\"I02\",\"evidence_id\":\"E002\",\"kind\":\"ANSWER\",\"answer_status\":\"DIRECT\",\"question\":null},{\"item_id\":\"I03\",\"evidence_id\":\"E002\",\"kind\":\"DIAGNOSTIC_REQUEST\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I04\",\"evidence_id\":\"E003\",\"kind\":\"QUESTION\",\"answer_status\":null,\"question\":{\"status\":\"PARTIAL\",\"answer_item_ids\":[\"I05\"],\"resolution_confidence\":0.73,\"uncertainty_note\":{\"text\":\"The thread provides a case where the recommendation would not change and asks whether correcting the error would change the answer a user acts on, but it does not state a complete rule for all cases.\",\"evidence_ids\":[\"E004\",\"E005\"]}}},{\"item_id\":\"I05\",\"evidence_id\":\"E004\",\"kind\":\"ANSWER\",\"answer_status\":\"DIRECT\",\"question\":null},{\"item_id\":\"I06\",\"evidence_id\":\"E005\",\"kind\":\"DIAGNOSTIC_REQUEST\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I07\",\"evidence_id\":\"E006\",\"kind\":\"QUESTION\",\"answer_status\":null,\"question\":{\"status\":\"PARTIAL\",\"answer_item_ids\":[\"I08\",\"I10\"],\"resolution_confidence\":0.84,\"uncertainty_note\":{\"text\":\"Replies say the decision depends on whether the fact drives the final answer and on task context, and they request the original question and incorrect fact before deciding this specific case.\",\"evidence_ids\":[\"E007\",\"E008\"]}}},{\"item_id\":\"I08\",\"evidence_id\":\"E007\",\"kind\":\"ANSWER\",\"answer_status\":\"DIRECT\",\"question\":null},{\"item_id\":\"I09\",\"evidence_id\":\"E007\",\"kind\":\"DIAGNOSTIC_REQUEST\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I10\",\"evidence_id\":\"E008\",\"kind\":\"ANSWER\",\"answer_status\":\"DIRECT\",\"question\":null},{\"item_id\":\"I11\",\"evidence_id\":\"E008\",\"kind\":\"INSTRUCTION\",\"answer_status\":null,\"question\":null}],\"dispositions\":[],\"impact\":{\"criteria\":[{\"criterion\":\"insufficient_impact_evidence\",\"basis\":\"INSUFFICIENT_EVIDENCE\",\"observation\":{\"text\":\"The thread cluster shows rubric-interpretation questions and task-specific clarification about how to judge factual errors, but it does not report a concrete inability to perform work, a submission failure, or an observed quality outcome caused by the uncertainty.\",\"evidence_ids\":[\"E001\",\"E003\",\"E006\",\"E002\",\"E005\",\"E007\",\"E008\"]}}],\"affected_scope\":null}}]}",
