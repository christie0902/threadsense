        "content": "{\"topics\":[{\"topic_name\":\"Language adherence when a response switches languages within a supposedly monolingual prompt\",\"member_ids\":[\"M01\",\"M02\",\"M03\",\"M04\"],\"shared_issue\":{\"text\":\"Members discuss how to judge language adherence when a response includes another language inside an otherwise monolingual prompt, distinguishing substantial unexplained language switching from ordinary borrowed or loan words and noting that the prompt should be checked before penalizing bilingual output.\",\"evidence_ids\":[\"E003\",\"E008\",\"E010\"]},\"relevant_differences\":[{\"text\":\"Examples involve different language pairs: Korean prompt with English inserted versus Spanish prompt with English inserted.\",\"evidence_ids\":[\"E001\",\"E006\"]},{\"text\":\"Some reports describe an English paragraph in the middle, while another says the response is mostly in the requested language but switches to English for the explanation.\",\"evidence_ids\":[\"E001\",\"E007\"]},{\"text\":\"One conversation explicitly asks QA for clarification, while other conversations mainly report or discuss the case without an explicit handling question.\",\"evidence_ids\":[\"E004\",\"E001\",\"E006\",\"E009\"]}],\"inventory\":[{\"item_id\":\"I01\",\"evidence_id\":\"E001\",\"kind\":\"FACT\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I02\",\"evidence_id\":\"E002\",\"kind\":\"ANSWER\",\"answer_status\":\"DIRECT\",\"question\":null},{\"item_id\":\"I03\",\"evidence_id\":\"E003\",\"kind\":\"DIAGNOSTIC_REQUEST\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I04\",\"evidence_id\":\"E004\",\"kind\":\"QUESTION\",\"answer_status\":null,\"question\":{\"status\":\"OPEN\",\"answer_item_ids\":[],\"resolution_confidence\":0.87,\"uncertainty_note\":{\"text\":\"The follow-up asks whether the case is only a borrowed term or a substantial unrequested language change, so the requested clarification depends on details not yet established in the thread.\",\"evidence_