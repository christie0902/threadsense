        "content": "{\"topics\":[{\"topic_name\":\"Korean honorific-to-informal speech shift handling\",\"member_ids\":[\"M01\",\"M02\",\"M03\",\"M04\"],\"shared_issue\":{\"text\":\"Members raised QA handling questions about Korean responses that begin in honorific speech and then switch to informal speech; replies asked for sentence-level context and endings before deciding how to judge the shift.\",\"evidence_ids\":[\"E002\",\"E005\",\"E008\",\"E009\",\"E010\"]},\"relevant_differences\":[{\"text\":\"M01 and M02 also asked whether a similar prior-batch discussion could be found, while a later TL reply in M03 said that prior-batch discussion was not yet verified.\",\"evidence_ids\":[\"E001\",\"E002\",\"E008\"]},{\"text\":\"M02 specifically asked whether the shift should be treated as a major naturalness error, whereas M03 asked which QA rule to follow and M04 asked for the correct handling for a specific task.\",\"evidence_ids\":[\"E002\",\"E005\",\"E009\"]},{\"text\":\"In M02, replies suggested that a quote from another speaker could justify an otherwise inconsistent honorific change and asked whether the addressee changed; M03 and M04 instead focused on collecting the exact Korean sentences and endings before any severity decision.\",\"evidence_ids\":[\"E003\",\"E004\",\"E006\",\"E007\",\"E008\",\"E010\"]}],\"inventory\":[{\"item_id\":\"I01\",\"evidence_id\":\"E001\",\"kind\":\"FACT\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I02\",\"evidence_id\":\"E001\",\"kind\":\"DIAGNOSTIC_REQUEST\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I03\",\"evidence_id\":\"E002\",\"kind\":\"FACT\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I04\",\"evidence_id\":\"E002\",\"kind\":\"QUESTION\",\"answer_status\":null,\"question\":{\"status\":\"PARTIAL\",\"answer_item_ids\":[\"I06\"],\"resolution_confidence\":0.57,\"uncertainty_note\":{\"text\":\"The thread asks whether this is a major naturalness error, but the reply only provides a conditional justification and requests more contextual checking rather than fully classifying the case.\",\"evidence_ids\":[\"E002\",\"E003\",\"E004\"]}}},{\"item_id\":\"I05\",\"evidence_id\":\"E002\",\"kind\":\"DIAGNOSTIC_REQUEST\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I06\",\"evidence_id\":\"E003\",\"kind\":\"ANSWER\",\"answer_status\":\"TENTATIVE\",\"question\":null},{\"item_id\":\"I07\",\"evidence_id\":\"E004\",\"kind\":\"DIAGNOSTIC_REQUEST\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I08\",\"evidence_id\":\"E005\",\"kind\":\"FACT\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I09\",\"evidence_id\":\"E005\",\"kind\":\"QUESTION\",\"answer_status\":null,\"question\":{\"status\":\"OPEN\",\"answer_item_ids\":[],\"resolution_confidence\":0.86,\"uncertainty_note\":{\"text\":\"Replies request the Korean context and endings and state that severity should not be decided yet, so no explicit QA rule is provided in this conversation.\",\"evidence_ids\":[\"E006\",\"E007\",\"E008\"]}}},{\"item_id\":\"I10\",\"evidence_id\":\"E006\",\"kind\":\"FACT\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I11\",\"evidence_id\":\"E006\",\"kind\":\"DIAGNOSTIC_REQUEST\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I12\",\"evidence_id\":\"E007\",\"kind\":\"DIAGNOSTIC_REQUEST\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I13\",\"evidence_id\":\"E008\",\"kind\":\"INSTRUCTION\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I14\",\"evidence_id\":\"E008\",\"kind\":\"FACT\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I15\",\"evidence_id\":\"E009\",\"kind\":\"FACT\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I16\",\"evidence_id\":\"E009\",\"kind\":\"QUESTION\",\"answer_status\":null,\"question\":{\"status\":\"OPEN\",\"answer_item_ids\":[],\"resolution_confidence\":0.9,\"uncertainty_note\":{\"text\":\"The only reply asks for the two Korean sentences so the language reviewer can inspect the end