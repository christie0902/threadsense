        "content": "{\n  \"schema_version\": 2,\n  \"candidate_group_id\": \"cluster_6ac8dcc3e5d75776\",\n  \"project_id\": \"multilingual_eval\",\n  \"batch_id\": \"multi_batch_11\",\n  \"is_coherent\": true,\n  \"coherence_rationale\": \"The threads discuss the acceptability of Vietnamese wording in relation to regional preferences, with various members contributing to the conversation about northern and southern Vietnamese usage.\",\n  \"topics\": [\n    {\n      \"topic_name\": \"Vietnamese Wording Acceptability\",\n      \"member_ids\": [\n        \"member_c3707719bca997c3dd94c00a\",\n        \"member_19a98c7ed9854e63bbe246ea\",\n        \"member_63b6316b5be79f145f9aa8dc\",\n        \"member_5d8a6d979476b72e39ea05e8\"\n      ],\n      \"conversation_kind\": \"MIXED\",\n      \"shared_issue\": {\n        \"text\": \"The appropriateness of Vietnamese wording in a QA review context, considering regional differences.\",\n        \"evidence\": [\n          {\n            \"member_id\": \"member_c3707719bca997c3dd94c00a\",\n            \"message_id\": \"1790905292.000185\",\n            \"quote\": \"Vietnamese wording is natural in the south, but QA reviewer is from the north.\"\n          },\n          {\n            \"member_id\": \"member_19a98c7ed9854e63bbe246ea\",\n            \"message_id\": \"1790924170.000183\",\n            \"quote\": \"Anyone else seeing this? Is this northern wording acceptable for southern users? (task ref MULTI-4170)\"\n          },\n          {\n            \"member_id\": \"member_63b6316b5be79f145f9aa8dc\",\n            \"message_id\": \"1790857852.000186\",\n            \"quote\": \"Is this northern wording acceptable for southern users?\"\n          },\n          {\n            \"member_id\": \"member_5d8a6d979476b72e39ea05e8\",\n            \"message_id\": \"1790869911.000187\",\n            \"quote\": \"Regional phrase sounds fine in VN but QA flags it.\"\n          }\n        ]\n      },\n      \"representative_question\": {\n        \"text\": \"What should be done when Vietnamese wording is natural in the south, but the QA reviewer is from the north?\",\n        \"evidence\": [\n          {\n            \"member_id\": \"member_c3707719bca997c3dd94c00a\",\n            \"message_id\": \"1790905292.000185\",\n            \"quote\": \"What should be done when Vietnamese wording is natural in the south, but the QA reviewer is from the north?\"\n          }\n        ]\n      },\n      \"relevant_differences\": [\n        {\n          \"text\": \"Different perspectives on whether northern wording is acceptable for southern users.\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_19a98c7ed9854e63bbe246ea\",\n              \"message_id\": \"1790924170.000183\",\n              \"quote\": \"The word is common in the south but QA seems to expect northern usage.\"\n            },\n            {\n              \"member_id\": \"member_5d8a6d979476b72e39ea05e8\",\n              \"message_id\": \"1790869911.000187\",\n              \"quote\": \"The word is common in the south but QA seems to expect northern usage.\"\n            }\n          ]\n        }\n      ],\n      \"open_questions\": [\n        {\n          \"text\": \"Is the wording natural for the intended audience even if unfamiliar elsewhere?\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_19a98c7ed9854e63bbe246ea\",\n              \"message_id\": \"1790924261.000226\",\n              \"quote\": \"Is the wording natural for the intended audience even if unfamiliar elsewhere?\"\n            }\n          ]\n        }\n      ],\n      \"supported_answers\": [\n        {\n          \"text\": \"Confirmation on whether the target is general Vietnamese or a specified region is needed before setting scoring guidance.\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_c3707719bca997c3dd94c00a\",\n              \"message_id\": \"1790905384.000226\",\n    