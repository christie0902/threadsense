        "content": "{\n  \"schema_version\": 2,\n  \"candidate_group_id\": \"cluster_db20d884110726af\",\n  \"project_id\": \"multilingual_eval\",\n  \"batch_id\": \"multi_batch_11\",\n  \"is_coherent\": false,\n  \"coherence_rationale\": \"The threads discuss similar issues regarding shifts in speech levels in Japanese but do not resolve the central questions uniformly, leading to different states of resolution.\",\n  \"topics\": [\n    {\n      \"topic_name\": \"Shift in Speech Levels in Japanese Responses\",\n      \"member_ids\": [\n        \"member_c0e209a71f0bd7157b85d5f4\",\n        \"member_312342420c2338d5fbce8532\",\n        \"member_dc26e975ca3fa5cce7ea30e5\"\n      ],\n      \"conversation_kind\": \"MIXED\",\n      \"shared_issue\": {\n        \"text\": \"Concerns regarding abrupt shifts in speech levels in Japanese responses.\",\n        \"evidence\": [\n          {\n            \"member_id\": \"member_c0e209a71f0bd7157b85d5f4\",\n            \"message_id\": \"1790902834.000157\",\n            \"quote\": \"Anyone else seeing this? Japanese response starts with です/ます then shifts to plain style abruptly. (task ref MULTI-2834)\"\n          },\n          {\n            \"member_id\": \"member_312342420c2338d5fbce8532\",\n            \"message_id\": \"1790939293.000156\",\n            \"quote\": \"[Task review] Issue: Keigo is correct at the start, but the closing feels too casual. Penalty?\"\n          },\n          {\n            \"member_id\": \"member_dc26e975ca3fa5cce7ea30e5\",\n            \"message_id\": \"1790876285.000158\",\n            \"quote\": \"Could QA clarify this case: Keigo suddenly becomes casual — how to score?\"\n          }\n        ]\n      },\n      \"representative_question\": {\n        \"text\": \"Is there a discourse reason for the abrupt shift in speech level in the Japanese response?\",\n        \"evidence\": [\n          {\n            \"member_id\": \"member_c0e209a71f0bd7157b85d5f4\",\n            \"message_id\": \"1790902834.000157\",\n            \"quote\": \"Is there a discourse reason to switch speech level?\"\n          }\n        ]\n      },\n      \"relevant_differences\": [\n        {\n          \"text\": \"Different threads address the shift in speech levels with varying degrees of resolution.\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_312342420c2338d5fbce8532\",\n              \"message_id\": \"1790939293.000156\",\n              \"quote\": \"Japanese QA needs the beginning and ending forms to determine whether the shift is stylistic or erroneous.\"\n            },\n            {\n              \"member_id\": \"member_dc26e975ca3fa5cce7ea30e5\",\n              \"message_id\": \"1790876285.000158\",\n              \"quote\": \"A purposeful switch between speakers differs from accidental keigo inconsistency.\"\n            }\n          ]\n        }\n      ],\n      \"open_questions\": [\n        {\n          \"text\": \"What is the correct handling for this task regarding the use of Keigo, considering the closing feels too casual?\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_312342420c2338d5fbce8532\",\n              \"message_id\": \"1790939293.000156\",\n              \"quote\": \"Question: what is the correct handling for this task?\"\n            }\n          ]\n        },\n        {\n          \"text\": \"Could QA clarify this case: Keigo suddenly becomes casual — how to score?\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_dc26e975ca3fa5cce7ea30e5\",\n              \"message_id\": \"1790876285.000158\",\n              \"quote\": \"Could QA clarify this case: Keigo suddenly becomes casual — how to score?\"\n            }\n          ]\n        }\n      ],\n      \"supported_answers\": [],\n      \"uncertainties\": [\n        {\n          \"text\": \"The specific handling or penalty for the task remains unresolved.\",\n          \"evidence\": [\n            {\