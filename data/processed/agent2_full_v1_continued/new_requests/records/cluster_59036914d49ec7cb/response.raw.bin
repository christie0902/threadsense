        "content": "{\n  \"schema_version\": 2,\n  \"candidate_group_id\": \"cluster_59036914d49ec7cb\",\n  \"project_id\": \"multilingual_eval\",\n  \"batch_id\": \"multi_batch_11\",\n  \"is_coherent\": false,\n  \"coherence_rationale\": \"The threads discuss different aspects of QA disagreements regarding naturalness scores and regional word choices, but they do not converge on a single issue or resolution.\",\n  \"topics\": [\n    {\n      \"topic_name\": \"QA Disagreement on Naturalness Scores\",\n      \"member_ids\": [\n        \"member_07c71eabdc14fa8de4866dc7\",\n        \"member_686e44d6c57000947905013b\"\n      ],\n      \"conversation_kind\": \"DISCUSSION\",\n      \"shared_issue\": {\n        \"text\": \"There are disagreements among reviewers regarding the naturalness of phrases for specific locales.\",\n        \"evidence\": [\n          {\n            \"member_id\": \"member_07c71eabdc14fa8de4866dc7\",\n            \"message_id\": \"1790873741.000176\",\n            \"quote\": \"Last batch also had QA disagreement for this locale.\"\n          },\n          {\n            \"member_id\": \"member_686e44d6c57000947905013b\",\n            \"message_id\": \"1790910768.000174\",\n            \"quote\": \"QA consensus isn't holding on regional word choice.\"\n          }\n        ]\n      },\n      \"representative_question\": {\n        \"text\": \"What should be done when QA consensus is not holding on regional word choice?\",\n        \"evidence\": [\n          {\n            \"member_id\": \"member_686e44d6c57000947905013b\",\n            \"message_id\": \"1790910768.000174\",\n            \"quote\": \"Language QA needs the target locale and both explanations before we declare one interpretation authoritative.\"\n          }\n        ]\n      },\n      \"relevant_differences\": [\n        {\n          \"text\": \"Different reviewers have conflicting expectations regarding regional variants.\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_686e44d6c57000947905013b\",\n              \"message_id\": \"1790910768.000174\",\n              \"quote\": \"One reviewer expects a regional variant while another rejects it.\"\n            }\n          ]\n        }\n      ],\n      \"open_questions\": [\n        {\n          \"text\": \"How to align opposite naturalness scores given by two native reviewers?\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_e23a03b9093648d682757f17\",\n              \"message_id\": \"1790876988.000175\",\n              \"quote\": \"Two native reviewers gave opposite naturalness scores. How to align?\"\n            }\n          ]\n        }\n      ],\n      \"supported_answers\": [],\n      \"uncertainties\": [\n        {\n          \"text\": \"The specific decision on what should be done when QA consensus is not holding remains unanswered.\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_686e44d6c57000947905013b\",\n              \"message_id\": \"1790910768.000174\",\n              \"quote\": \"However, the specific decision on what should be done when QA consensus is not holding remains unanswered.\"\n            }\n          ]\n        }\n      ]\n    },\n    {\n      \"topic_name\": \"Alignment of Reviewer Scores\",\n      \"member_ids\": [\n        \"member_e23a03b9093648d682757f17\"\n      ],\n      \"conversation_kind\": \"DISCUSSION\",\n      \"shared_issue\": {\n        \"text\": \"There is a need to align opposite naturalness scores given by two native reviewers.\",\n        \"evidence\": [\n          {\n            \"member_id\": \"member_e23a03b9093648d682757f17\",\n            \"message_id\": \"1790876988.000175\",\n            \"quote\": \"Two native reviewers gave opposite naturalness scores.\"\n          }\n        ]\n      },\n      \"representative_question\": {\n        \"text\": \"How to align opposite naturalness scores given by two native reviewers?\",\n        \"evidence