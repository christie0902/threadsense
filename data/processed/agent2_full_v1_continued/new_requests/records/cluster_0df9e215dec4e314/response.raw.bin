      "message": {
        "role": "assistant",
        "content": "{\n  \"schema_version\": 2,\n  \"candidate_group_id\": \"cluster_0df9e215dec4e314\",\n  \"project_id\": \"multilingual_eval\",\n  \"batch_id\": \"multi_batch_11\",\n  \"is_coherent\": true,\n  \"coherence_rationale\": \"The topics discuss similar issues regarding language adherence in responses to prompts in different languages.\",\n  \"topics\": [\n    {\n      \"topic_name\": \"Language Adherence in Responses\",\n      \"member_ids\": [\n        \"member_67958b644e55776329b30810\",\n        \"member_010c2785d8ee301e24894be8\",\n        \"member_75230fe43b892c1390926067\",\n        \"member_e22608ab9115cb70013e4e88\"\n      ],\n      \"conversation_kind\": \"MIXED\",\n      \"shared_issue\": {\n        \"text\": \"The inclusion of English in responses to prompts in Korean or Spanish raises questions about language adherence.\",\n        \"evidence\": [\n          {\n            \"member_id\": \"member_67958b644e55776329b30810\",\n            \"message_id\": \"1790871835.000151\",\n            \"quote\": \"Prompt is in Korean but the answer drops an English paragraph in the middle. (task ref MULTI-1835)\"\n          },\n          {\n            \"member_id\": \"member_75230fe43b892c1390926067\",\n            \"message_id\": \"1790935980.000148\",\n            \"quote\": \"Model mixes Spanish and English even though the user asked for Spanish. (task ref MULTI-5980)\"\n          },\n          {\n            \"member_id\": \"member_e22608ab9115cb70013e4e88\",\n            \"message_id\": \"1790882060.000149\",\n            \"quote\": \"Model mixes Spanish and English even though the user asked for Spanish.\"\n          }\n        ]\n      },\n      \"representative_question\": {\n        \"text\": \"Is the inclusion of an English paragraph in a response to a Korean prompt acceptable, or should it be penalized?\",\n        \"evidence\": [\n          {\n            \"member_id\": \"member_67958b644e55776329b30810\",\n            \"message_id\": \"1790871835.000151\",\n            \"quote\": \"Did the user request one language throughout or invite code-switching?\"\n          }\n        ]\n      },\n      \"relevant_differences\": [\n        {\n          \"text\": \"Different contexts of language mixing: Korean prompt with English inclusion vs. Spanish prompt with English inclusion.\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_010c2785d8ee301e24894be8\",\n              \"message_id\": \"1790932114.000145\",\n              \"quote\": \"Is this a single borrowed term or a substantial unrequested language change?\"\n            },\n            {\n              \"member_id\": \"member_75230fe43b892c1390926067\",\n              \"message_id\": \"1790935980.000148\",\n              \"quote\": \"For the specified monolingual prompt, an unexplained paragraph in another language counts against language adherence.\"\n            }\n          ]\n        }\n      ],\n      \"open_questions\": [\n        {\n          \"text\": \"What specific criteria should be used to evaluate bilingual responses?\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_75230fe43b892c1390926067\",\n              \"message_id\": \"1790935980.000148\",\n              \"quote\": \"We should look at the prompt before penalizing a bilingual response.\"\n            }\n          ]\n        }\n      ],\n      \"supported_answers\": [],\n      \"uncertainties\": [\n        {\n          \"text\": \"The exact user intent regarding language use in prompts is unclear.\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_67958b644e55776329b30810\",\n              \"message_id\": \"1790871932.000226\",\n              \"quote\": \"Did the user request one language throughout or invite code-switching?\"\n            }\n          ]\n        }\n      ]\n    }\n  ],\n  \"needs_review\": false,\n  \"review_reasons\": []\n}",
