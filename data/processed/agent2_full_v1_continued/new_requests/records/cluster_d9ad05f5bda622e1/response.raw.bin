        "content": "{\n  \"schema_version\": 2,\n  \"candidate_group_id\": \"cluster_d9ad05f5bda622e1\",\n  \"project_id\": \"safety_classification\",\n  \"batch_id\": \"safety_batch_08\",\n  \"is_coherent\": true,\n  \"coherence_rationale\": \"The threads discuss the handling of fake email addresses and whether they require Quality Notes (QN), with varying degrees of resolution.\",\n  \"topics\": [\n    {\n      \"topic_name\": \"Handling of Fake Email Addresses\",\n      \"member_ids\": [\n        \"member_68b6c06c2198c6e02e87d841\",\n        \"member_83bf399505a4fa8d03f5f1b6\",\n        \"member_28bcdf8b10a3addf72c9e677\"\n      ],\n      \"conversation_kind\": \"MIXED\",\n      \"shared_issue\": {\n        \"text\": \"Do fake email addresses need QN?\",\n        \"evidence\": [\n          {\n            \"member_id\": \"member_68b6c06c2198c6e02e87d841\",\n            \"message_id\": \"1790871263.000058\",\n            \"quote\": \"[Task review]\\nIssue: Do fake email addresses need QN?\\nQuestion: what is the correct handling for this task? I have two versions of the note open and they seem to differ.\"\n          },\n          {\n            \"member_id\": \"member_28bcdf8b10a3addf72c9e677\",\n            \"message_id\": \"1790922378.000060\",\n            \"quote\": \"[Task review]\\nIssue: Do fake email addresses need QN?\\nQuestion: what is the correct handling for this task? (task ref SAFETY-2378)\"\n          }\n        ]\n      },\n      \"representative_question\": {\n        \"text\": \"What is the correct handling for fake email addresses?\",\n        \"evidence\": [\n          {\n            \"member_id\": \"member_68b6c06c2198c6e02e87d841\",\n            \"message_id\": \"1790871263.000058\",\n            \"quote\": \"Question: what is the correct handling for this task? I have two versions of the note open and they seem to differ.\"\n          }\n        ]\n      },\n      \"relevant_differences\": [\n        {\n          \"text\": \"Responses vary in resolution regarding the need for QN.\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_83bf399505a4fa8d03f5f1b6\",\n              \"message_id\": \"1790908330.000339\",\n              \"quote\": \"For this task, clearly fictional placeholder contact details alone do not require QN.\"\n            },\n            {\n              \"member_id\": \"member_28bcdf8b10a3addf72c9e677\",\n              \"message_id\": \"1790922435.000113\",\n              \"quote\": \"The example address uses an obvious placeholder domain, not a real contact.\"\n            }\n          ]\n        }\n      ],\n      \"open_questions\": [\n        {\n          \"text\": \"What is the correct handling for fake email addresses?\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_28bcdf8b10a3addf72c9e677\",\n              \"message_id\": \"1790922378.000060\",\n              \"quote\": \"Question: what is the correct handling for this task? (task ref SAFETY-2378)\"\n            }\n          ]\n        }\n      ],\n      \"supported_answers\": [\n        {\n          \"text\": \"Fictional placeholder contact details do not require QN.\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_83bf399505a4fa8d03f5f1b6\",\n              \"message_id\": \"1790908330.000339\",\n              \"quote\": \"For this task, clearly fictional placeholder contact details alone do not require QN.\"\n            }\n          ]\n        }\n      ],\n      \"uncertainties\": [\n        {\n          \"text\": \"Whether all fake email addresses are treated the same way.\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_68b6c06c2198c6e02e87d841\",\n              \"message_id\": \"1790871365.000226\",\n              \"quote\": \"The posted wording may conflict with older PII examples.\"\n            }\n          ]\n        }\n      ]\n    }\n  ],\n  \"needs_review\": false,\n  \"review_r