        "content": "{\"topics\":[{\"topic_name\":\"Conflicting safety labels for closely matched examples\",\"member_ids\":[\"M01\",\"M02\"],\"shared_issue\":{\"text\":\"Members reported inconsistent safety labeling for closely matched or contextually equivalent examples, and guidance stated that when the relevant context is the same, the same safety threshold should be applied while any real difference is recorded explicitly.\",\"evidence_ids\":[\"E002\",\"E004\",\"E007\"]},\"relevant_differences\":[{\"text\":\"One conversation reported borderline items being classified more strictly and different labels on the same contextual passage without posing an explicit handling question.\",\"evidence_ids\":[\"E001\",\"E002\"]},{\"text\":\"The other conversation explicitly asked for the correct handling of a specific task, included caution that both QA rationales were needed before calling it QA drift, and raised a comparability check about intent and explicitness before the final handling answer.\",\"evidence_ids\":[\"E004\",\"E005\",\"E006\",\"E007\"]}],\"inventory\":[{\"item_id\":\"I001\",\"evidence_id\":\"E001\",\"kind\":\"FACT\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I002\",\"evidence_id\":\"E002\",\"kind\":\"FACT\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I003\",\"evidence_id\":\"E003\",\"kind\":\"INSTRUCTION\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I004\",\"evidence_id\":\"E004\",\"kind\":\"QUESTION\",\"answer_status\":null,\"question\":{\"status\":\"ANSWERED\",\"answer_item_ids\":[\"I007\"],\"resolution_confidence\":0.88,\"uncertainty_note\":{\"text\":\"The answer is scoped to 'this example' and depends on the examples sharing the same relevant context; an earlier reply questioned whether they were truly comparable in intent and explicitness.\",\"evidence_ids\":[\"E006\",\"E007\"]}}},{\"item_id\":\"I005\",\"evidence_id\":\"E005\",\"kind\":\"INSTRUCTION\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I006