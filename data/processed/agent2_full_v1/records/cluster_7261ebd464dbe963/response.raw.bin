        "role": "assistant",
        "content": "{\n  \"schema_version\": 2,\n  \"candidate_group_id\": \"cluster_7261ebd464dbe963\",\n  \"project_id\": \"multilingual_eval\",\n  \"batch_id\": \"multi_batch_11\",\n  \"is_coherent\": true,\n  \"coherence_rationale\": \"The topics discussed in the threads are related to handling mixed-language responses and code-switching in QA tracking, providing a coherent narrative around the issue.\",\n  \"topics\": [\n    {\n      \"topic_name\": \"QA Tracking for Mixed-Language Responses\",\n      \"member_ids\": [\n        \"member_491115a8192c2b466db8033c\",\n        \"member_ca3005e17eb2ae0b4b49dfc8\",\n        \"member_1b4fb2bb48f19c459cfe9e6b\"\n      ],\n      \"conversation_kind\": \"MIXED\",\n      \"shared_issue\": {\n        \"text\": \"There is a need to clarify how to handle mixed-language responses and code-switching in QA tracking.\",\n        \"evidence\": [\n          {\n            \"member_id\": \"member_491115a8192c2b466db8033c\",\n            \"message_id\": \"1790861853.000153\",\n            \"quote\": \"QA tracking (MULTI-1853): Scoring mixed-language responses when prompts or context invite code switching. Add affected task references here; no policy change has been announced.\"\n          }\n        ]\n      },\n      \"representative_question\": {\n        \"text\": \"Should the response mirror the user's code-switching?\",\n        \"evidence\": [\n          {\n            \"member_id\": \"member_ca3005e17eb2ae0b4b49dfc8\",\n            \"message_id\": \"1790927651.000146\",\n            \"quote\": \"User code-switched; should response mirror it?\"\n          }\n        ]\n      },\n      \"relevant_differences\": [\n        {\n          \"text\": \"Different interpretations of how to handle code-switching in responses.\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_ca3005e17eb2ae0b4b49dfc8\",\n              \"message_id\": \"1790927651.000146\",\n              \"quote\": \"Because the user mixed languages, check the stated output-language requirement before penalizing a mixed-language reply; code-switching alone does not settle the score.\"\n            }\n          ]\n        },\n        {\n          \"text\": \"The need for exact requests to determine appropriate responses.\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_1b4fb2bb48f19c459cfe9e6b\",\n              \"message_id\": \"1790866887.000147\",\n              \"quote\": \"The user already mixed languages, so a bilingual reply may be appropriate; we need the exact request.\"\n            }\n          ]\n        }\n      ],\n      \"open_questions\": [\n        {\n          \"text\": \"What specific tasks are affected by the mixed-language scoring?\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_491115a8192c2b466db8033c\",\n              \"message_id\": \"1790861853.000153\",\n              \"quote\": \"Add affected task references here; no policy change has been announced.\"\n            }\n          ]\n        }\n      ],\n      \"supported_answers\": [\n        {\n          \"text\": \"Responses do not need to mirror code-switching unless specified by the output-language requirement.\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_ca3005e17eb2ae0b4b49dfc8\",\n              \"message_id\": \"1790927651.000146\",\n              \"quote\": \"Because the user mixed languages, check the stated output-language requirement before penalizing a mixed-language reply; code-switching alone does not settle the score.\"\n            }\n          ]\n        }\n      ],\n      \"uncertainties\": []\n    }\n  ],\n  \"needs_review\": false,\n  \"review_reasons\": []\n}",
