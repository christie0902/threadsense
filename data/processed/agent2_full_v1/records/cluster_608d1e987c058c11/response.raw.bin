        "content": "{\n  \"schema_version\": 2,\n  \"candidate_group_id\": \"cluster_608d1e987c058c11\",\n  \"project_id\": \"multilingual_eval\",\n  \"batch_id\": \"multi_batch_11\",\n  \"is_coherent\": true,\n  \"coherence_rationale\": \"The topics address related issues regarding submission failures in the multilingual task, with multiple users reporting similar problems.\",\n  \"topics\": [\n    {\n      \"topic_name\": \"Submit Button Disabled Issue\",\n      \"member_ids\": [\n        \"member_4c1c3194ad963d5c61ef425d\",\n        \"member_a0e8e21fd079b3167031c525\"\n      ],\n      \"conversation_kind\": \"MIXED\",\n      \"shared_issue\": {\n        \"text\": \"Multiple users reported that the Submit button remains disabled despite filling out all fields in the multilingual task.\",\n        \"evidence\": [\n          {\n            \"member_id\": \"member_4c1c3194ad963d5c61ef425d\",\n            \"message_id\": \"1790894107.000172\",\n            \"quote\": \"The multilingual task has every field filled, yet Submit stays disabled.\"\n          },\n          {\n            \"member_id\": \"member_4c1c3194ad963d5c61ef425d\",\n            \"message_id\": \"1790894157.000113\",\n            \"quote\": \"I finished every rubric field but the Submit button remains disabled.\"\n          }\n        ]\n      },\n      \"representative_question\": {\n        \"text\": \"Why does the Submit button remain disabled even though every field in the multilingual task is filled?\",\n        \"evidence\": [\n          {\n            \"member_id\": \"member_4c1c3194ad963d5c61ef425d\",\n            \"message_id\": \"1790894107.000172\",\n            \"quote\": \"The multilingual task has every field filled, yet Submit stays disabled.\"\n          }\n        ]\n      },\n      \"relevant_differences\": [],\n      \"open_questions\": [\n        {\n          \"text\": \"What specific conditions lead to the Submit button being disabled?\",\n          \"evidence\": [\n            {\