        "content": "{\n  \"schema_version\": 2,\n  \"candidate_group_id\": \"cluster_dc219b33a3be1a2e\",\n  \"project_id\": \"response_preference\",\n  \"batch_id\": \"rp_batch_15\",\n  \"is_coherent\": true,\n  \"coherence_rationale\": \"The topics discuss similar issues regarding response-fetch failures and timeout problems in the labeling tool, with members requesting additional information to assess the situation.\",\n  \"topics\": [\n    {\n      \"topic_name\": \"Response Fetch Failures in Label Tool\",\n      \"member_ids\": [\n        \"member_39be46641107cea5c7626e55\",\n        \"member_a2f0abeaf568ff6802ec5e14\"\n      ],\n      \"conversation_kind\": \"MIXED\",\n      \"shared_issue\": {\n        \"text\": \"There are issues with the Label Tool timing out and failing to display response content.\",\n        \"evidence\": [\n          {\n            \"member_id\": \"member_39be46641107cea5c7626e55\",\n            \"message_id\": \"1790897195.000027\",\n            \"quote\": \"LT times out before Response A and B are displayed.\"\n          },\n          {\n            \"member_id\": \"member_a2f0abeaf568ff6802ec5e14\",\n            \"message_id\": \"1790920271.000026\",\n            \"quote\": \"Response-fetch fails before I can compare this pair.\"\n          }\n        ]\n      },\n      \"representative_question\": {\n        \"text\": \"What is the task reference and error state to assess whether the issue is widespread or task-specific?\",\n        \"evidence\": [\n          {\n            \"member_id\": \"member_39be46641107cea5c7626e55\",\n            \"message_id\": \"1790897339.000339\",\n            \"quote\": \"We need the task reference and the error state before deciding whether this is widespread or task-specific.\"\n          }\n        ]\n      },\n      \"relevant_differences\": [\n        {\n          \"text\": \"In the first thread, the issue is primarily about timing out before displaying responses, while in the second thread, it focuses on response-fetch failures.\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_39be46641107cea5c7626e55\",\n              \"message_id\": \"1790897253.000113\",\n              \"quote\": \"The task metadata loads but there is no response content to evaluate.\"\n            },\n            {\n              \"member_id\": \"member_a2f0abeaf568ff6802ec5e14\",\n              \"message_id\": \"1790920325.000113\",\n              \"quote\": \"I tried a second item and the response still failed to appear.\"\n            }\n          ]\n        }\n      ],\n      \"open_questions\": [\n        {\n          \"text\": \"Was the task metadata visible before the output pane timed out?\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_a2f0abeaf568ff6802ec5e14\",\n              \"message_id\": \"1790920371.000226\",\n              \"quote\": \"Was the task metadata visible before the output pane timed out?\"\n            }\n          ]\n        }\n      ],\n      \"supported_answers\": [],\n      \"uncertainties\": []\n    }\n  ],\n  \"needs_review\": true,\n  \"review_reasons\": []\n}",
