        "content": "{\n  \"schema_version\": 2,\n  \"candidate_group_id\": \"cluster_3b950ad40b12ab58\",\n  \"project_id\": \"multilingual_eval\",\n  \"batch_id\": \"multi_batch_11\",\n  \"is_coherent\": true,\n  \"coherence_rationale\": \"The topics are related to the use of 존댓말 and 반말 in the context of QA discussions, focusing on whether shifts between formal and informal speech constitute errors.\",\n  \"topics\": [\n    {\n      \"topic_name\": \"Switching between 존댓말 and 반말\",\n      \"member_ids\": [\n        \"member_8c54e5824868d24507d20361\",\n        \"member_74e92dc600ce9bbc7f5bfc91\",\n        \"member_fd22fa33e77a761978a1a44e\",\n        \"member_bac94c44f7245ade46fc1c0e\"\n      ],\n      \"conversation_kind\": \"MIXED\",\n      \"shared_issue\": {\n        \"text\": \"There are multiple discussions regarding the appropriateness of switching between 존댓말 (formal speech) and 반말 (informal speech) in responses.\",\n        \"evidence\": [\n          {\n            \"member_id\": \"member_8c54e5824868d24507d20361\",\n            \"message_id\": \"1790856672.000159\",\n            \"quote\": \"Answer starts in 존댓말 then switches to 반말. This feels familiar from the last batch; can someone locate that discussion?\"\n          },\n          {\n            \"member_id\": \"member_74e92dc600ce9bbc7f5bfc91\",\n            \"message_id\": \"1790882012.001500\",\n            \"quote\": \"Starts in 존댓말 and suddenly uses 반말. Is that a major naturalness error? This feels familiar from the last batch; can someone locate that discussion? (task ref MULTI-2012)\"\n          },\n          {\n            \"member_id\": \"member_fd22fa33e77a761978a1a44e\",\n            \"message_id\": \"1790897091.000160\",\n            \"quote\": \"한 문단은 존댓말이고 다음 문단은 반말이에요. Which QA rule should we follow?\"\n          },\n          {\n            \"member_id\": \"member_bac94c44f7245ade46fc1c0e\",\n            \"message_id\": \"1790931281.000162\",\n            \"quote\": \"[QA clarification] Issue: Answer starts in 존댓말 then switches to 반말.\"\n          }\n        ]\n      },\n      \"representative_question\": {\n        \"text\": \"Is the shift from 존댓말 to 반말 a major naturalness error?\",\n        \"evidence\": [\n          {\n            \"member_id\": \"member_74e92dc600ce9bbc7f5bfc91\",\n            \"message_id\": \"1790882012.001500\",\n            \"quote\": \"Starts in 존댓말 and suddenly uses 반말. Is that a major naturalness error?\"\n          }\n        ]\n      },\n      \"relevant_differences\": [\n        {\n          \"text\": \"Different members express varying concerns about the implications of switching speech levels.\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_74e92dc600ce9bbc7f5bfc91\",\n              \"message_id\": \"1790882012.001500\",\n              \"quote\": \"The prompt never asks for casual speech, but the model suddenly gets informal.\"\n            },\n            {\n              \"member_id\": \"member_fd22fa33e77a761978a1a44e\",\n              \"message_id\": \"1790897091.000160\",\n              \"quote\": \"Before deciding severity, Korean QA needs the context and the sentence endings.\"\n            }\n          ]\n        }\n      ],\n      \"open_questions\": [\n        {\n          \"text\": \"What is the correct handling for this task?\",\n          \"evidence\": [\n            {\n              \"member_id\": \"member_bac94c44f7245ade46fc1c0e\",\n              \"message_id\": \"1790931281.000162\",\n              \"quote\": \"Question: what is the correct handling for this task? (task ref MULTI-1281)\"\n            }\n          ]\n        }\n      ],\n      \"supported_answers\": [],\n      \"uncertainties\": []\n    }\n  ],\n  \"needs_review\": false,\n  \"review_reasons\": []\n}",
