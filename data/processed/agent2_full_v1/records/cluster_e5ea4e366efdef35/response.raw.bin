        "content": "{\n  \"schema_version\": 2,\n  \"candidate_group_id\": \"cluster_e5ea4e366efdef35\",\n  \"project_id\": \"audio_multimodal\",\n  \"batch_id\": \"audio_batch_06\",\n  \"is_coherent\": true,\n  \"coherence_rationale\": \"The topics discuss similar issues regarding the classification of audio artifacts, specifically static noise and mild clipping, both of which are unresolved questions in the QA process.\",\n  \"topics\": [\n    {\n      \"topic_name\": \"Classification of Static Noise\",\n      \"member_ids\": [\n        \"member_4d29a575cd8491bd99a586c4\"\n      ],\n      \"conversation_kind\": \"DISCUSSION\",\n      \"shared_issue\": {\n        \"text\": \"Is static noise a major artifact or minor?\",\n        \"evidence\": [\n          {\n            \"member_id\": \"member_4d29a575cd8491bd99a586c4\",\n            \"message_id\": \"1790894026.000120\",\n            \"quote\": \"Is static noise a major artifact or minor?\"\n          },\n          {\n            \"member_id\": \"member_4d29a575cd8491bd99a586c4\",\n            \"message_id\": \"1790894072.000113\",\n            \"quote\": \"One QA pass marks this background static as major, another as minor.\"\n          },\n          {\n            \"member_id\": \"member_4d29a575cd8491bd99a586c4\",\n            \"message_id\": \"1790894125.000226\",\n            \"quote\": \"Can both reviewers mark the exact timestamp where the defect occurs? If intelligibility remains intact, document why the artifact rating was chosen.\"\n          },\n          {\n            \"member_id\": \"member_4d29a575cd8491bd99a586c4\",\n            \"message_id\": \"1790894163.000339\",\n            \"quote\": \"Please note the artifact timestamps and whether speech remains intelligible; otherwise we cannot calibrate severity.\"\n          }\n        ]\n      },\n      \"representative_question\": {\n        \"text\": \"Is static noise a major artifact or minor?\",\n        \"evidence\": [\n          {\n            \"member_id\": \"member_4d29a575cd8491bd99a586c4\",\n            \"message_id\": \"1790894026.000120\",\n            \"quote\": \"Is static noise a major artifact or minor?\"\n          }\n        ]\n      },\n      \"relevant_differences\": [],\n      \"open_questions\": [],\n      \"supported_answers\": [],\n      \"uncertainties\": []\n    },\n    {\n      \"topic_name\": \"Classification of Mild Clipping\",\n      \"member_ids\": [\n        \"member_7b07aa5def81bd2c0a86511e\"\n      ],\n      \"conversation_kind\": \"DISCUSSION\",\n      \"shared_issue\": {\n        \"text\": \"Should mild clipping in audio be considered a major defect?\",\n        \"evidence\": [\n          {\n            \"member_id\": \"member_7b07aa5def81bd2c0a86511e\",\n            \"message_id\": \"1790897512.000121\",\n            \"quote\": \"QA split on whether mild clipping should count as a major defect. (task ref AUDIO-7512)\"\n          },\n          {\n            \"member_id\": \"member_7b07aa5def81bd2c0a86511e\",\n            \"message_id\": \"1790897560.000113\",\n            \"quote\": \"The clipping is audible in the loudest phrase, but I can still understand the words.\"\n          },\n          {\n            \"member_id\": \"member_7b07aa5def81bd2c0a86511e\",\n            \"message_id\": \"1790897607.000226\",\n            \"quote\": \"Does the clipping obscure words or only briefly affect sound quality?\"\n          }\n        ]\n      },\n      \"representative_question\": {\n        \"text\": \"Should mild clipping in audio be considered a major defect?\",\n        \"evidence\": [\n          {\n            \"member_id\": \"member_7b07aa5def81bd2c0a86511e\",\n            \"message_id\": \"1790897512.000121\",\n            \"quote\": \"QA split on whether mild clipping should count as a major defect. (task ref AUDIO-7512)\"\n          }\n        ]\n      },\n      \"relevant_differences\": [],\n      \"open_questions\": [],\n      \"supported_answers\": [],\n      \"uncertainties\": []\n    }\n  ],\n  \"needs_review\": false,\n  \"review_reasons\": []\n}",
