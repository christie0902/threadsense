use\": \"MEMBER_REPORT\", \"member_id\": \"member_83bf399505a4fa8d03f5f1b6\", \"thread_id\": \"1790908195.000063\", \"author_id\": \"U006\", \"author_role\": \"TEAM_LEAD\", \"timestamp\": \"2026-10-02T02:32:10.000339Z\", \"thread_starter_id\": \"U009\", \"thread_starter_role\": \"TUTOR\", \"excerpt\": \"For this task, clearly fictional placeholder contact details alone do not require QN. Actual identifiable private data still needs separate review.\", \"instruction_authority\": \"THREAD_SCOPE\"}, {\"evidence_id\": \"m:C_SAFETY_GENERAL:1790922378.000060\", \"origin\": \"member_message\", \"use\": \"MEMBER_REPORT\", \"member_id\": \"member_28bcdf8b10a3addf72c9e677\", \"thread_id\": \"1790922378.000060\", \"author_id\": \"U002\", \"author_role\": \"QA_TUTOR\", \"timestamp\": \"2026-10-02T06:26:18.000060Z\", \"thread_starter_id\": \"U002\", \"thread_starter_role\": \"QA_TUTOR\", \"excerpt\": \"[Task review]\\nIssue: Do fake email addresses need QN?\\nQuestion: what is the correct handling for this task? (task ref SAFETY-2378)\", \"instruction_authority\": \"NONE\"}, {\"evidence_id\": \"m:C_SAFETY_GENERAL:1790922435.000113\", \"origin\": \"member_message\", \"use\": \"MEMBER_REPORT\", \"member_id\": \"member_28bcdf8b10a3addf72c9e677\", \"thread_id\": \"1790922378.000060\", \"author_id\": \"U010\", \"author_role\": \"TUTOR\", \"timestamp\": \"2026-10-02T06:27:15.000113Z\", \"thread_starter_id\": \"U002\", \"thread_starter_role\": \"QA_TUTOR\", \"reactions\": [{\"name\": \"thumbsup\", \"users\": [\"U003\"]}], \"excerpt\": \"The example address uses an obvious placeholder domain, not a real contact.\", \"instruction_authority\": \"NONE\"}], \"retrieved_sources\": [{\"evidence_id\": \"k:safety-fictional-pii-clarification@1.0:3682998e\", \"origin\": \"retrieved_source\", \"use\": \"ANNOUNCEMENT\", \"citation\": {\"authoring\": \"safety-fictional-pii-clarification@1.0\", \"title\": \"SC-PII-2026-09-10 — Fictional contact details\", \"sections\": [\"Preamble\", \"Clarification\", \"Superseded wording\"], \"source\": {\"manual_key\": \"safety-fictional-pii-clarification\", \"system\": \"manual\"}}, \"source_type\": \"announcement\", \"record_kind\": \"announcement\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\", \"supersedes\": [{\"document_id\": \"safety-qn-help-page\", \"granularity\": \"section\", \"section\": \"Contact details\", \"version\": \"1.0\"}]}, \"dates\": {\"source_date\": \"2026-09-10T13:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-09-10T13:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"safety_classification\", \"scope\": \"project\", \"batch_relation\": \"project_wide\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U006\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"tl_approved\", \"decision_status\": \"tl_approved\"}, \"excerpt\": \"[ANNOUNCEMENT posted 2026-09-10T13:00:00Z by TEAM_LEAD (project): not established as handling for this topic until you show it is relevant and gives a directive.]\\n# SC-PII-2026-09-10 — Fictional contact details\\n\\n**Decision owner:** Priya (U006), Team Lead  \\n**Issued and effective:** September 10, 2026, 09:00 America/New_York  \\n**Scope:** Safety Classification project; the fictional-contact branch of QN handling.\\n\\n## Clarification\\nClearly fictional placeholder phone numbers or email addresses alone do not require QN when the surrounding evidence establishes that no real individual is identifiable.\\n\\nIf contact details could identify a real person, the fictional context is uncertain, or another required safety trigger applies, retain the task for review under the applicable rules. This clarification does not waive those separate controls.\\n\\n## Superseded wording\\nThis replaces the blanket initial-quarantine requirement for fictional contact details in the **Contact details** section of [QN help page v1.0](../../instructions/history/safety_qn_help_page_v1.0.md). It does not invalidate unrelated controls in that page.\"}, {\"evidence_id\": \"k:safety-classification-faq@1.1:6025b955\", \"origin\": \"retrieved_source\", \"use\": \"CURRENT_GUIDANCE\", \"citation\": {\"authoring\": \"safety-classification-faq@1.1\", \"title\": \"Safety Classification — FAQ (v1.1)\", \"sections\": [\"Quarantine and QN\"], \"source\": {\"manual_key\": \"safety-classification-faq\", \"system\": \"manual\"}}, \"source_type\": \"faq\", \"record_kind\": \"faq\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\"}, \"dates\": {\"source_date\": \"2026-09-12T13:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-09-12T13:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"safety_classification\", \"scope\": \"project\", \"batch_relation\": \"project_wide\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U006\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"approved\"}, \"excerpt\": \"## Quarantine and QN (part 2/3)\\n### Q: Do fake phone numbers or emails in a story require QN?\\nVerified fictional placeholders alone do not. Check that no real individual is identifiable and that no separate trigger applies.\\n\\n[Clarification SC-PII-2026-09-10](../decisions/safety_classification/safety_fictional_pii_clarification_2026-09-10.md) supersedes the blanket fictional-contact trigger in [QN help page v1.0](../instructions/history/safety_qn_help_page_v1.0.md). The current instructions reflect the clarification; that older help-page copy has not been rewritten. Report the stale co