arter_id\": \"U018\", \"thread_starter_role\": \"TUTOR\", \"reactions\": [{\"name\": \"thinking_face\", \"users\": [\"U018\"]}], \"excerpt\": \"Two native reviewers disagree about whether this phrase is natural for the target locale.\", \"instruction_authority\": \"NONE\"}, {\"evidence_id\": \"m:C_MULTI_GENERAL:1790873841.000226\", \"origin\": \"member_message\", \"use\": \"MEMBER_REPORT\", \"member_id\": \"member_07c71eabdc14fa8de4866dc7\", \"thread_id\": \"1790873741.000176\", \"author_id\": \"U014\", \"author_role\": \"QA_TUTOR\", \"timestamp\": \"2026-10-01T16:57:21.000226Z\", \"thread_starter_id\": \"U018\", \"thread_starter_role\": \"TUTOR\", \"reactions\": [{\"name\": \"this\", \"users\": [\"U001\"]}], \"excerpt\": \"For this item, use the audience locale specified in the prompt and document the rationale. Do not turn a different regional preference into a universal error.\", \"instruction_authority\": \"NONE\"}, {\"evidence_id\": \"m:C_MULTI_QA:1790876988.000175\", \"origin\": \"member_message\", \"use\": \"MEMBER_REPORT\", \"member_id\": \"member_e23a03b9093648d682757f17\", \"thread_id\": \"1790876988.000175\", \"author_id\": \"U008\", \"author_role\": \"QA_TUTOR\", \"timestamp\": \"2026-10-01T17:49:48.000175Z\", \"thread_starter_id\": \"U008\", \"thread_starter_role\": \"QA_TUTOR\", \"excerpt\": \"Two native reviewers gave opposite naturalness scores. How to align? This feels familiar from the last batch; can someone locate that discussion? (task ref MULTI-6988)\", \"instruction_authority\": \"NONE\"}, {\"evidence_id\": \"m:C_MULTI_QA:1790877042.000113\", \"origin\": \"member_message\", \"use\": \"MEMBER_REPORT\", \"member_id\": \"member_e23a03b9093648d682757f17\", \"thread_id\": \"1790876988.000175\", \"author_id\": \"U011\", \"author_role\": \"TUTOR\", \"timestamp\": \"2026-10-01T17:50:42.000113Z\", \"thread_starter_id\": \"U008\", \"thread_starter_role\": \"QA_TUTOR\", \"excerpt\": \"One reviewer expects a regional variant while another rejects it. Please ask both reviewers to cite the wording they objected to.\", \"instruction_authority\": \"NONE\"}, {\"evidence_id\": \"m:C_MULTI_QA:1790877090.000226\", \"origin\": \"member_message\", \"use\": \"MEMBER_REPORT\", \"member_id\": \"member_e23a03b9093648d682757f17\", \"thread_id\": \"1790876988.000175\", \"author_id\": \"U007\", \"author_role\": \"QA_TUTOR\", \"timestamp\": \"2026-10-01T17:51:30.000226Z\", \"thread_starter_id\": \"U008\", \"thread_starter_role\": \"QA_TUTOR\", \"excerpt\": \"What locale and audience were specified for this task? Regional familiarity and grammatical correctness should not be conflated.\", \"instruction_authority\": \"NONE\"}, {\"evidence_id\": \"m:C_MULTI_GENERAL:1790910768.000174\", \"origin\": \"member_message\", \"use\": \"MEMBER_REPORT\", \"member_id\": \"member_686e44d6c57000947905013b\", \"thread_id\": \"1790910768.000174\", \"author_id\": \"U018\", \"author_role\": \"TUTOR\", \"timestamp\": \"2026-10-02T03:12:48.000174Z\", \"thread_starter_id\": \"U018\", \"thread_starter_role\": \"TUTOR\", \"excerpt\": \"QA consensus isn't holding on regional word choice.\", \"instruction_authority\": \"NONE\"}, {\"evidence_id\": \"m:C_MULTI_GENERAL:1790910820.000113\", \"origin\": \"member_message\", \"use\": \"MEMBER_REPORT\", \"member_id\": \"member_686e44d6c57000947905013b\", \"thread_id\": \"1790910768.000174\", \"author_id\": \"U009\", \"author_role\": \"TUTOR\", \"timestamp\": \"2026-10-02T03:13:40.000113Z\", \"thread_starter_id\": \"U018\", \"thread_starter_role\": \"TUTOR\", \"reactions\": [{\"name\": \"thumbsup\", \"users\": [\"U015\"]}], \"excerpt\": \"One reviewer expects a regional variant while another rejects it.\", \"instruction_authority\": \"NONE\"}, {\"evidence_id\": \"m:C_MULTI_GENERAL:1790910863.000226\", \"origin\": \"member_message\", \"use\": \"MEMBER_REPORT\", \"member_id\": \"member_686e44d6c57000947905013b\", \"thread_id\": \"1790910768.000174\", \"author_id\": \"U014\", \"author_role\": \"QA_TUTOR\", \"timestamp\": \"2026-10-02T03:14:23.000226Z\", \"thread_starter_id\": \"U018\", \"thread_starter_role\": \"TUTOR\", \"excerpt\": \"Can both reviewers explain their judgments against the same locale target?\", \"instruction_authority\": \"NONE\"}, {\"evidence_id\": \"m:C_MULTI_GENERAL:1790910906.000339\", \"origin\": \"member_message\", \"use\": \"MEMBER_REPORT\", \"member_id\": \"member_686e44d6c57000947905013b\", \"thread_id\": \"1790910768.000174\", \"author_id\": \"U001\", \"author_role\": \"TEAM_LEAD\", \"timestamp\": \"2026-10-02T03:15:06.000339Z\", \"thread_starter_id\": \"U018\", \"thread_starter_role\": \"TUTOR\", \"excerpt\": \"Language QA needs the target locale and both explanations before we declare one interpretation authoritative. Do the notes describe a locale mismatch or an actual fluency problem?\", \"instruction_authority\": \"THREAD_SCOPE\"}], \"retrieved_sources\": [{\"evidence_id\": \"k:multilingual-eval-instructions@1.2:db772378\", \"origin\": \"retrieved_source\", \"use\": \"CURRENT_GUIDANCE\", \"citation\": {\"authoring\": \"multilingual-eval-instructions@1.2\", \"title\": \"Multilingual Evaluation — Instructions (v1.2)\", \"sections\": [\"Content-quality rubric\"], \"source\": {\"manual_key\": \"multilingual-eval-instructions\", \"system\": \"manual\"}}, \"source_type\": \"guideline\", \"record_kind\": \"guideline\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\"}, \"dates\": {\"source_date\": \"2026-09-10T13:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-09-10T13:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"multilingual_eval\", \"scope\": \"project\", \"batch_relation\": \"project_wide\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U001\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"approved\"}, \"excerpt\": \"## Content-quality rubric\\nThese grades concern task-quality defects. Language QA must establish context and impact for disputed locale-specific cases.\\n\\n| Dimension | Major defect | Minor defect | Acceptable / no automatic penalty |\\n| --- | --- | --- | --- |\\n| Language adherence | Substantial unrequested language mismatch violating the requirement | Limited genuine mismatch with a stated requirement | Ordinary loanwords or switching permitted by the task |\\n| Register / honorifics | Unmotivated, materially disruptive inconsistency confirmed in context | Localized inappropriate shift with limited effect | Natural variation, quotation or a justified addressee change |\\n| Regional appropriateness | Clear material mismatch with the specified audience | Localized genuine mismatch with limited effect | Regional vocabulary natural for the intended audience |\\n| Naturalness | Demonstrable phrasing problems that materially impair meaning or appropriate use | Identifiable localized awkwardness | A reviewer preference without an identifiable error |\"}, {\"evidence_id\": \"k:multilingual-eval-instructions@1.2:b26ca59b\", \"origin\": \"retrieved_source\", \"use\": \"CURRENT_GUIDANCE\", \"citation\": {\"authoring\": \"multilingual-eval-instructions@1.2\", \"title\": \"Multilingual Evaluation — Instructions (v1.2)\", \"sections\": [\"Regional variation and naturalness\"], \"source\": {\"manual_key\": \"multilingual-eval-instructions\", \"system\": \"manual\"}}, \"source_type\": \"guideline\", \"record_kind\": \"guideline\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\"}, \"dates\": {\"source_date\": \"2026-09-10T13:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-09-10T13:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"multilingual_eval\", \"scope\": \"project\", \"batch_relation\": \"project_wide\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U001\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"approved\"}, \"excerpt\": \"## Regional variation and naturalness\\nAssess wording against the specified locale or audience. Natural Southern Vietnamese vocabulary is not an error merely because a Northern reviewer prefers a different word. Reviewer preference or a majority vote alone does not establish a linguistic defect; identify the wording and its effect.\"}, {\"evidence_id\": \"k:multilingual-eval-faq@1.1:c080929d\", \"origin\": \"retrieved_source\", \"use\": \"CURRENT_GUIDANCE\", \"citation\": {\"authoring\": \"multilingual-eval-faq@1.1\", \"title\": \"Multilingual Evaluation — FAQ (v1.1)\", \"sections\": [\"Register and honorifics\"], \"source\": {\"manual_key\": \"multilingual-eval-faq\", \"system\": \"manual\"}}, \"source_type\": \"faq\", \"record_kind\": \"faq\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\"}, \"dates\": {\"source_date\": \"2026-09-18T13:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-09-18T13:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"multilingual_eval\", \"scope\": \"project\", \"batch_relation\": \"project_wide\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U001\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"approved\"}, \"excerpt\": \"## Register and honorifics\\n\\n### Q: Who scores Korean or Japanese register shifts?\\nRoute the case to appropriate Korean or Japanese language QA with exact sentence endings and surrounding context