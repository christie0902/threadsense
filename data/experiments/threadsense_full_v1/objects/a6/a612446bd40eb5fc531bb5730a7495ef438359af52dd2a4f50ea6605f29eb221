_QA:1790876988.000175\", \"role\": \"QA_TUTOR\"}, {\"user_id\": \"U018\", \"relation\": \"AUTHOR\", \"evidence_id\": \"m:C_MULTI_GENERAL:1790910768.000174\", \"role\": \"TUTOR\"}]}, {\"statement_id\": \"summary:s2\", \"kind\": \"SUMMARY\", \"text\": \"Current guidance requires judging wording against the intended audience rather than reviewer preference, while requested task context and reviewer explanations remain absent from the threads.\", \"evidence_ids\": [\"k:multilingual-eval-instructions@1.2:b26ca59b\", \"m:C_MULTI_QA:1790876988.000175\", \"m:C_MULTI_QA:1790877042.000113\", \"m:C_MULTI_QA:1790877090.000226\", \"m:C_MULTI_GENERAL:1790910768.000174\", \"m:C_MULTI_GENERAL:1790910820.000113\", \"m:C_MULTI_GENERAL:1790910863.000226\", \"m:C_MULTI_GENERAL:1790910906.000339\"], \"attributions\": [{\"user_id\": \"U011\", \"relation\": \"AUTHOR\", \"evidence_id\": \"m:C_MULTI_QA:1790877042.000113\", \"role\": \"TUTOR\"}, {\"user_id\": \"U007\", \"relation\": \"AUTHOR\", \"evidence_id\": \"m:C_MULTI_QA:1790877090.000226\", \"role\": \"QA_TUTOR\"}, {\"user_id\": \"U001\", \"relation\": \"AUTHOR\", \"evidence_id\": \"m:C_MULTI_GENERAL:1790910906.000339\", \"role\": \"TEAM_LEAD\"}]}, {\"statement_id\": \"detail:d1\", \"kind\": \"DETAIL\", \"text\": \"A tutor reports disagreement about a phrase's naturalness; a QA tutor reports opposite naturalness scores on MULTI-6988.\", \"evidence_ids\": [\"m:C_MULTI_GENERAL:1790873793.000113\", \"m:C_MULTI_QA:1790876988.000175\"], \"attributions\": [{\"user_id\": \"U013\", \"relation\": \"AUTHOR\", \"evidence_id\": \"m:C_MULTI_GENERAL:1790873793.000113\", \"role\": \"TUTOR\"}, {\"user_id\": \"U008\", \"relation\": \"AUTHOR\", \"evidence_id\": \"m:C_MULTI_QA:1790876988.000175\", \"role\": \"QA_TUTOR\"}]}, {\"statement_id\": \"detail:d2\", \"kind\": \"DETAIL\", \"text\": \"Two tutors report opposing expectations for regional variants, one in MULTI-6988 and one in the later regional-word-choice thread, where a tutor also reports that QA consensus is not holding.\", \"evidence_ids\": [\"m:C_MULTI_GENERAL:1790910768.000174\", \"m:C_MULTI_GENERAL:1790910820.000113\", \"m:C_MULTI_QA:1790877042.000113\"], \"attributions\": [{\"user_id\": \"U018\", \"relation\": \"AUTHOR\", \"evidence_id\": \"m:C_MULTI_GENERAL:1790910768.000174\", \"role\": \"TUTOR\"}, {\"user_id\": \"U009\", \"relation\": \"AUTHOR\", \"evidence_id\": \"m:C_MULTI_GENERAL:1790910820.000113\", \"role\": \"TUTOR\"}, {\"user_id\": \"U011\", \"relation\": \"AUTHOR\", \"evidence_id\": \"m:C_MULTI_QA:1790877042.000113\", \"role\": \"TUTOR\"}]}, {\"statement_id\": \"detail:d3\", \"kind\": \"DETAIL\", \"text\": \"In MULTI-6988, a tutor asks for each reviewer's disputed wording and a QA tutor asks for the specified locale and audience; the thread contains no answers to those requests.\", \"evidence_ids\": [\"m:C_MULTI_QA:1790877042.000113\", \"m:C_MULTI_QA:1790877090.000226\", \"m:C_MULTI_QA:1790876988.000175\", \"m:C_MULTI_GENERAL:1790910768.000174\", \"m:C_MULTI_GENERAL:1790910820.000113\", \"m:C_MULTI_GENERAL:1790910863.000226\", \"m:C_MULTI_GENERAL:1790910906.000339\"], \"attributions\": [{\"user_id\": \"U011\", \"relation\": \"AUTHOR\", \"evidence_id\": \"m:C_MULTI_QA:1790877042.000113\", \"role\": \"TUTOR\"}, {\"user_id\": \"U007\", \"relation\": \"AUTHOR\", \"evidence_id\": \"m:C_MULTI_QA:1790877090.000226\", \"role\": \"QA_TUTOR\"}, {\"user_id\": \"U001\", \"relation\": \"AUTHOR\", \"evidence_id\": \"m:C_MULTI_GENERAL:1790910906.000339\", \"role\": \"TEAM_LEAD\"}]}, {\"statement_id\": \"detail:d4\", \"kind\": \"DETAIL\", \"text\": \"In the regional-word-choice thread, the team lead requires the target locale and both explanations before declaring one interpretation authoritative; those inputs are not supplied in the thread.\", \"evidence_ids\": [\"m:C_MULTI_GENERAL:1790910906.000339\", \"m:C_MULTI_QA:1790876988.000175\", \"m:C_MULTI_QA:1790877042.000113\", \"m:C_MULTI_QA:1790877090.000226\", \"m:C_MULTI_GENERAL:1790910768.000174\", \"m:C_MULTI_GENERAL:1790910820.000113\", \"m:C_MULTI_GENERAL:1790910863.000226\"], \"attributions\": [{\"user_id\": \"U001\", \"relation\": \"AUTHOR\", \"evidence_id\": \"m:C_MULTI_GENERAL:1790910906.000339\", \"role\": \"TEAM_LEAD\"}, {\"user_id\": \"U011\", \"relation\": \"AUTHOR\", \"evidence_id\": \"m:C_MULTI_QA:1790877042.000113\", \"role\": \"TUTOR\"}, {\"user_id\": \"U007\", \"relation\": \"AUTHOR\", \"evidence_id\": \"m:C_MULTI_QA:1790877090.000226\", \"role\": \"QA_TUTOR\"}]}, {\"statement_id\": \"detail:d5\", \"kind\": \"DETAIL\", \"text\": \"A tutor reports similar disagreement in the previous batch, and a QA tutor asks to locate that earlier discussion.\", \"evidence_ids\": [\"m:C_MULTI_GENERAL:1790873741.000176\", \"m:C_MULTI_QA:1790876988.000175\"], \"attributions\": [{\"user_id\": \"U018\", \"relation\": \"AUTHOR\", \"evidence_id\": \"m:C_MULTI_GENERAL:1790873741.000176\", \"role\": \"TUTOR\"}, {\"user_id\": \"U008\", \"relation\": \"AUTHOR\", \"evidence_id\": \"m:C_MULTI_QA:1790876988.000175\", \"role\": \"QA_TUTOR\"}]}, {\"statement_id\": \"detail:d6\", \"kind\": \"DETAIL\", \"text\": \"The records retrieved for this run do not locate the requested earlier naturalness discussion or its outcome; the retrieved earlier language-QA referral concerns Japanese register and records an assessment still awaiting context.\", \"evidence_ids\": [\"k:multi-japanese-review-pending@1.0:124c6b92\", \"k:multi-locale-announcement@1.0:e97783e3\", \"k:multilingual-eval-instructions@1.2:e19f0e0c\", \"k:multi-audit-filename-convention-approval@1.0:a5a80940\"], \"depends_on\": [\"detail:d5\"]}, {\"statement_id\": \"action\", \"kind\": \"ACTION\", \"text\": \"Post a reminder. Instruction: Post a reminder to the reporting tutors and QA tutors to judge against the intended audience and document disputed wording and context. Draft to copy: A tutor and a QA tutor report conflicting naturalness judgments, including MULTI-6988. Two tutors report opposing expectations for regional variants, including in MULTI-6988; a tutor reports that regional-word-choice consensus is not holding.\\n\\nAssess wording against the specified locale or audience. Preference or a majority vote alone does not establish a defect: identify the wording and its effect. Confirm the audience before penalizing regional wording, and provide the exact phrase and prompt context.\\n\\n- For MULTI-6988, please answer the tutor's request for each reviewer's disputed wording and the QA tutor's question about the specified locale and audience.\\n- In the regional-word-choice thread, please provide the target locale and both explanations before we declare one interpretation authoritative, distinguishing a locale mismatch from a fluency problem. Scope: The audience-based standard and request for exact phrase and prompt context apply across these reports; the requirement for both explanations before declaring an interpretation authoritative remains specific to the regional-word-choice thread.\", \"evidence_ids\": [\"m:C_MULTI_GENERAL:1790873793.000113\", \"m:C_MULTI_QA:1790876988.000175\", \"m:C_MULTI_GENERAL:1790910768.000174\", \"m:C_MULTI_GENERAL:1790910820.000113\", \"m:C_MULTI_QA:1790877042.000113\", \"m:C_MULTI_QA:1790877090.000226\", \"m:C_MULTI_GENERAL:1790910906.000339\", \"k:multilingual-eval-instructions@1.2:b26ca59b\", \"m:C_MULTI_GENERAL:1790910863.000226\", \"k:multi-locale-announcement@1.0:e97783e3\"], \"premises\": [{\"statement_id\": \"claim:c1\", \"status\": \"PENDING_YOUR_VERDICT\"}, {\"statement_id\": \"claim:c2\", \"status\": \"PENDING_YOUR_VERDICT\"}, {\"statement_id\": \"claim:c3\", \"status\": \"PENDING_YOUR_VERDICT\"}, {\"statement_id\": \"claim:c4\", \"status\": \"PENDING_YOUR_VERDICT\"}, {\"statement_id\": \"claim:c5\", \"status\": \"PENDING_YOUR_VERDICT\"}, {\"statement_id\": \"claim:c6\", \"status\": \"PENDING_YOUR_VERDICT\"}, {\"statement_id\": \"claim:c9\", \"status\": \"PENDING_YOUR_VERDICT\"}, {\"statement_id\": \"claim:c10\", \"status\": \"PENDING_YOUR_VERDICT\"}, {\"statement_id\": \"claim:c13\", \"status\": \"PENDING_YOUR_VERDICT\"}, {\"statement_id\": \"claim:c14\", \"status\": \"PENDING_YOUR_VERDICT\", \"depends_on\": [\"announcement:k:multi-locale-announcement@1.0:e97783e3\"]}]}, {\"statement_id\": \"action:rationale\", \"kind\": \"ACTION_RATIONALE\", \"text\": \"Why this helps: Current instructions and the batch announcement provide a shared basis for comparing judgments without treating preference or a majority vote as proof of an error. A reminder addresses the repeated disagreement without deciding cases whose context is still missing.\", \"evidence_ids\": [\"m:C_MULTI_GENERAL:1790873793.000113\", \"m:C_MULTI_QA:1790876988.000175\", \"m:C_MULTI_GENERAL:1790910768.000174\", \"m:C_MULTI_GENERAL:1790910820.000113\", \"m:C_MULTI_QA:1790877042.000113\", \"m:C_MULTI_QA:1790877090.000226\", \"m:C_MULTI_GENERAL:1790910906.000339\", \"k:multilingual-eval-instructions@1.2:b26ca59b\", \"m:C_MULTI_GENERAL:1790910863.000226\", \"k:multi-locale-announcement@1.0:e97783e3\", \"m:C_MULTI_GENERAL:1790873841.000226\", \"k:multilingual-eval-faq@1.1:9ea83675\", \"m:C_MULTI_GENERAL:1790873741.000176\", \"k:multi-japanese-review-pending@1.0:124c6b92\", \"k:multilingual-eval-instructions@1.2:e19f0e0c\", \"k:multi-audit-filename-convention-approval@1.0:a5a80940\"]}, {\"statement_id\": \"action:need\", \"kind\": \"INTERVENTION_NEED\", \"text\": \"Why intervening now is needed (an operational problem that needs coordination): Comparable disagreements over naturalness and regional wording appear across three threads, while requested inputs needed to compare the judgments remain missing.\", \"evidence_ids\": [\"m:C_MULTI_GENERAL:1790873793.000113\", \"m:C_MULTI_QA:1790876988.000175\", \"m:C_MULTI_GENERAL:1790910768.000174\", \"m:C_MULTI_QA:1790877042.000113\", \"m:C_MULTI_QA:1790877090.000226\", \"m:C_MULTI_GENERAL:1790910906.000339\"]}, {\"statement_id\": \"announcement:k:multi-locale-announcement@1.0:e97783e3\", \"kind\": \"ANNOUNCEMENT_HANDLING\", \"text\": \"This announcement applies to this topic and directs current handling: \\\"Multilingual batch 11: confirm the requested audience or locale before penalizing regional wording. Natural Southern Vietnamese vocabulary is not an error solely because a reviewer prefers a Northern term. Provide the exact phrase and prompt context.\\\". The announcement covers the same project and batch and directly addresses disputed regional wording. Its audience-confirmation and context requirements apply; the reports do not identify a language that would establish which language-specific destination applies.\", \"evidence_ids\": [\"k:multi-locale-announcement@1.0:e97783e3\"]}, {\"statement_id\": \"resolution:member_07c71eabdc14fa8de4866dc7\", \"kind\": \"RESOLUTION\", \"text\": \"Member thread member_07c71eabdc14fa8de4866dc7 is PARTIALLY_RESOLVED: A QA tutor supplies an audience-based approach and recommends documenting the rationale. The thread does not show agreement on the disputed phrase or a located earlier discussion.\", \"evidence_ids\": [\"m:C_MULTI_GENERAL:1790873741.000176\", \"m:C_MULTI_GENERAL:1790873793.000113\", \"m:C_MULTI_GENERAL:1790873841.000226\"]}, {\"statement_id\": \"resolution:member_e23a03b9093648d682757f17\", \"kind\": \"RESOLUTION\", \"text\": \"Member thread member_e23a03b9093648d682757f17 is UNRESOLVED: The QA tutor's alignment question receives requests for disputed wording and the specified locale and audience, but no comparison or settled scores. The requested earlier discussion is not located in the thread.\", \"evidence_ids\": [\"m:C_MULTI_QA:1790876988.000175\", \"m:C_MULTI_QA:1790877042.000113\", \"m:C_MULTI_QA:1790877090.000226\"]}, {\"statement_id\": \"resolution:member_686e44d6c57000947905013b\", \"kind\": \"RESOLUTION\", \"text\": \"Member thread member_686e44d6c57000947905013b is PARTIALLY_RESOLVED: The team lead establishes the inputs needed before choosing an authoritative interpretation. The thread does not supply those inputs or settle the disagreement.\", \"evidence_ids\": [\"m:C_MULTI_GENERAL:1790910768.000174\", \"m:C_MULTI_GENERAL:1790910820.000113\", \"m:C_MULTI_GENERAL:1790910863.000226\", \"m:C_MULTI_GENERAL:1790910906.000339\"]}, {\"statement_id\": \"severity:rationale\", \"kind\": \"SEVERITY_RATIONALE\", \"text\": \"Severity HIGH: Two tutors and a QA tutor report comparable disagreement over locale-specific judgments across three threads in the same batch and time window. This suggests a broader scoring-consistency risk, although the number of affected tasks is not established.\", \"evidence_ids\": [\"m:C_MULTI_GENERAL:1790873793.000113\", \"m:C_MULTI_QA:1790876988.000175\", \"m:C_MULTI_GENERAL:1790910768.000174\", \"m:C_MULTI_QA:1790877042.000113\", \"m:C_MULTI_GENERAL:1790910820.000113\", \"m:C_MULTI_QA:1790877090.000226\", \"m:C_MULTI_GENERAL:1790873841.000226\", \"m:C_MULTI_GENERAL:1790910863.000226\", \"m:C_MULTI_GENERAL:1790873741.000176\"]}, {\"statement_id\": \"severity:signal:HIGH[3]\", \"kind\": \"SEVERITY_SIGNAL\", \"text\": \"Rubric signal met - \\\"Multiple distinct people or affected tasks reporting a comparable problem within the relevant project, batch, and time window, suggesting broader disruption or systemic labeling risk. Consider the number affected relative to the known active group when that information is available; do not require an explicit statement of widespread impact\\\": A tutor reports native-reviewer disagreement over phrase naturalness, a QA tutor reports opposite naturalness scores on MULTI-6988, and a different tutor reports that regional-word-choice QA consensus is not holding.\", \"evidence_ids\": [\"m:C_MULTI_GENERAL:1790873793.000113\", \"m:C_MULTI_QA:1790876988.000175\", \"m:C_MULTI_GENERAL:1790910768.000174\"]}, {\"statement_id\": \"severity:reported_recurrence\", \"kind\": \"REPORTED_RECURRENCE\", \"text\": \"Members report that this is happening again (their report; not corroborated history).\", \"evidence_ids\": [\"m:C_MULT