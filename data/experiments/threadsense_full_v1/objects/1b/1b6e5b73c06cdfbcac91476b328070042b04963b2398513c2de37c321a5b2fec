ject_id\": \"safety_classification\", \"scope\": \"project\", \"batch_relation\": \"project_wide\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U006\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"approved\"}, \"excerpt\": \"## Conflicting sources\\n\\n### Q: A pinned flowchart and a TL clarification disagree. Which applies?\\nCheck exact source identity, project/case scope, authority, effective date and supersession. Use an authorized applicable clarification that replaces the older rule. A later timestamp or pinned location alone is insufficient. If these checks do not resolve the discrepancy, retain both sources for TL review.\"}, {\"evidence_id\": \"k:safety-classification-instructions@1.4:694627ca\", \"origin\": \"retrieved_source\", \"use\": \"CURRENT_GUIDANCE\", \"citation\": {\"authoring\": \"safety-classification-instructions@1.4\", \"title\": \"Safety Classification — Instructions (v1.4)\", \"sections\": [\"Project purpose\"], \"source\": {\"manual_key\": \"safety-classification-instructions\", \"system\": \"manual\"}}, \"source_type\": \"guideline\", \"record_kind\": \"guideline\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\"}, \"dates\": {\"source_date\": \"2026-09-10T15:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-09-10T15:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"safety_classification\", \"scope\": \"project\", \"batch_relation\": \"project_wide\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U006\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {