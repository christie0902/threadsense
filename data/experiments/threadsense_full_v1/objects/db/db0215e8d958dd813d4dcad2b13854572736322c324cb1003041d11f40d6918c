, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U001\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"approved\"}, \"excerpt\": \"## Register and honorifics\\n\\n### Q: Who scores Korean or Japanese register shifts?\\nRoute the case to appropriate Korean or Japanese language QA with exact sentence endings and surrounding context. Check quotations and addressee changes. The task-quality grade depends on demonstrated impact; do not assign a major penalty from the presence of a shift alone.\\n\\n### Q: Spanish tú versus usted inconsistency — major or minor?\\nAsk Spanish QA to check addressee, intended formality and discourse context. An unjustified shift can be an error, but its grade needs a case-specific rationale.\"}, {\"evidence_id\": \"k:multi-japanese-review-pending@1.0:124c6b92\", \"origin\": \"retrieved_source\", \"use\": \"PRIOR_DECISION\", \"citation\": {\"authoring\": \"multi-japanese-review-pending@1.0\", \"title\": \"Japanese register review awaiting complete context\", \"sections\": [\"Case packet\", \"TL routing\", \"State\"], \"source\": {\"manual_key\": \"multi-japanese-review-pending\", \"system\": \"manual\"}}, \"source_type\": \"decision\", \"record_kind\": \"expert_referral\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\", \"enactment\": {\"status\": \"NOT_ENACTED\", \"missing\": [\"NOT_A_POLICY_CHANGE\", \"NO_ENACTMENT_EVIDENCE\"]}}, \"dates\": {\"source_date\": \"2026-09-25T15:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-09-25T15:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"multilingual_eval\", \"batch_id\": \"multi_batch_11\", \"scope\": \"project\", \"batch_relation\": \"same_batch\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U001\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"tl_approved\", \"decision_status\": \"tl_approved\", \"execution_status\": \"routed\", \"outcome_status\": \"awaiting_context\"}, \"excerpt\": \"[PRIOR RECORD (expert_referral; decision_status: tl_approved; execution_status: routed; outcome_status: awaiting_context) - history, not a standing rule.]\\n# Japanese register review awaiting complete context\\n\\n## Case packet\\nM11-JA-022 was reported as starting in です/ます and ending in plain form. The supplied excerpt omitted the preceding dialogue and did not establish whether the closing sentence addressed the same person.\\n\\n## TL routing\\nAlex assigned the review to Yuki (U019, Japanese QA). Yuki requested the complete dialogue before deciding whether the change was purposeful. The follow-up was due September 30; this record contains no completed assessment.\\n\\n## State\\nThe case was routed, not resolved. No major/minor score or general keigo rule was approved. A due date is a requested follow-up time, not proof that the follow-up occurred.\"}, {\"evidence_id\": \"k:multi-korean-referral@1.0:929d7cee\", \"origin\": \"retrieved_source\", \"use\": \"PRIOR_DECISION\", \"citation\": {\"authoring\": \"multi-korean-referral@1.0\", \"title\": \"Korean register case referred to language QA\", \"sections\": [\"Request\", \"TL decision\", \"Requested assessment\", \"Scope\"], \"source\": {\"manual_key\": \"multi-korean-referral\", \"system\": \"manual\"}}, \"source_type\": \"decision\", \"record_kind\": \"expert_referral\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\", \"enactment\": {\"status\": \"NOT_ENACTED\", \"missing\": [\"OUT_OF_SCOPE\", \"NOT_A_POLICY_CHANGE\", \"NO_ENACTMENT_EVIDENCE\"]}}, \"dates\"