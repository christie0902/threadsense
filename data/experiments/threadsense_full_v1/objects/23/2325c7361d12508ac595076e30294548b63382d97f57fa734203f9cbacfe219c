ter_role\": \"TUTOR\", \"excerpt\": \"Does the file play correctly aside from being the wrong language?\", \"instruction_authority\": \"NONE\"}, {\"evidence_id\": \"m:C_AUDIO_GENERAL:1790875738.000226\", \"origin\": \"member_message\", \"use\": \"MEMBER_REPORT\", \"member_id\": \"member_522d6fd02658414bb1d253cd\", \"thread_id\": \"1790875641.000104\", \"author_id\": \"U006\", \"author_role\": \"TEAM_LEAD\", \"timestamp\": \"2026-10-01T17:28:58.000226Z\", \"thread_starter_id\": \"U004\", \"thread_starter_role\": \"TUTOR\", \"excerpt\": \"Can you confirm the requested language and what the speaker actually says? We need to rule out an intentional bilingual prompt.\", \"instruction_authority\": \"THREAD_SCOPE\"}, {\"evidence_id\": \"m:C_AUDIO_QA:1790891269.000101\", \"origin\": \"member_message\", \"use\": \"MEMBER_REPORT\", \"member_id\": \"member_c98d8294eb56987fb789dad2\", \"thread_id\": \"1790891269.000101\", \"author_id\": \"U002\", \"author_role\": \"QA_TUTOR\", \"timestamp\": \"2026-10-01T21:47:49.000101Z\", \"thread_starter_id\": \"U002\", \"thread_starter_role\": \"QA_TUTOR\", \"excerpt\": \"Task check: Speaker switches languages halfway even though the prompt is English-only.\", \"instruction_authority\": \"NONE\"}, {\"evidence_id\": \"m:C_AUDIO_QA:1790891320.000113\", \"origin\": \"member_message\", \"use\": \"MEMBER_REPORT\", \"member_id\": \"member_c98d8294eb56987fb789dad2\", \"thread_id\": \"1790891269.000101\", \"author_id\": \"U010\", \"author_role\": \"TUTOR\", \"timestamp\": \"2026-10-01T21:48:40.000113Z\", \"thread_starter_id\": \"U002\", \"thread_starter_role\": \"QA_TUTOR\", \"reactions\": [{\"name\": \"thinking_face\", \"users\": [\"U012\"]}], \"excerpt\": \"The reference text is English, but the rendered speech uses another language.\", \"instruction_authority\": \"NONE\"}, {\"evidence_id\": \"m:C_AUDIO_QA:1790891364.000226\", \"origin\": \"member_message\", \"use\": \"MEMBER_REPORT\", \"member_id\": \"member_c98d8294eb56987fb789dad2\", \"thread_id\": \"1790891269.000101\", \"author_id\": \"U007\", \"author_role\": \"QA_TUTOR\", \"timestamp\": \"2026-10-01T21:49:24.000226Z\", \"thread_starter_id\": \"U002\", \"thread_starter_role\": \"QA_TUTOR\", \"excerpt\": \"Was a language switch specifically requested anywhere in the prompt? Did the prompt permit a bilingual reading at any point?\", \"instruction_authority\": \"NONE\"}, {\"evidence_id\": \"m:C_AUDIO_QA:1790891406.000339\", \"origin\": \"member_message\", \"use\": \"MEMBER_REPORT\", \"member_id\": \"member_c98d8294eb56987fb789dad2\", \"thread_id\": \"1790891269.000101\", \"author_id\": \"U006\", \"author_role\": \"TEAM_LEAD\", \"timestamp\": \"2026-10-01T21:50:06.000339Z\", \"thread_starter_id\": \"U002\", \"thread_starter_role\": \"QA_TUTOR\", \"excerpt\": \"Can you confirm the requested language and what the speaker actually says? We need to rule out an intentional bilingual prompt. The prompt language and actual recording language need to be checked separately.\", \"instruction_authority\": \"THREAD_SCOPE\"}], \"retrieved_sources\": [{\"evidence_id\": \"k:audio-multimodal-instructions@1.3:7a5ab59d\", \"origin\": \"retrieved_source\", \"use\": \"CURRENT_GUIDANCE\", \"citation\": {\"authoring\": \"audio-multimodal-instructions@1.3\", \"title\": \"Audio Multimodal — Instructions (v1.3)\", \"sections\": [\"Language and repeated audio\"], \"source\": {\"manual_key\": \"audio-multimodal-instructions\", \"system\": \"manual\"}}, \"source_type\": \"guideline\", \"record_kind\": \"guideline\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\"}, \"dates\": {\"source_date\": \"2026-09-15T13:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-09-15T13:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"audio_multimodal\", \"scope\": \"project\", \"batch_relation\": \"project_wide\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U006\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"approved\"}, \"excerpt\": \"## Language and repeated audio\\nConfirm the requested language and any permitted switching before recording a language mismatch. A familiar accent or an ordinary loanword is not automatically a defect.\\n\\nWhen a phrase repeats, record where it occurs. If feasible, compare the downloaded file with player output. Do not call it a confirmed generation defect until the available evidence distinguishes generation from playback.\"}, {\"evidence_id\": \"k:audio-multimodal-instructions@1.3:1c6df70e\", \"origin\": \"retrieved_source\", \"use\": \"CURRENT_GUIDANCE\", \"citation\": {\"authoring\": \"audio-multimodal-instructions@1.3\", \"title\": \"Audio Multimodal — Instructions (v1.3)\", \"sections\": [\"Playback and unavailable content\"], \"source\": {\"manual_key\": \"audio-multimodal-instructions\", \"system\": \"manual\"}}, \"source_type\": \"guideline\", \"record_kind\": \"guideline\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\"}, \"dates\": {\"source_date\": \"2026-09-15T13:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-09-15T13:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"audio_multimodal\", \"scope\": \"project\", \"batch_relation\": \"project_wide\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U006\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"approved\"}, \"excerpt\": \"## Playback and unavailable content\\n- If the player fails to load or start, report a tool incident with the task ID.\\n- A visible waveform with no playback is still a playback/tool incident; the waveform alone does not establish that the recording is silent.\\n- Do not score unavailable audio as a model-quality failure or make a content-based Quarantine (QN) decision solely because playback is unavailable.\\n- Capture the browser/error state and whether another clip plays. An old workaround must be checked against the current symptoms; recurrence alone does not establish which fix was tried or why it failed.\\n- Handling guidance does not confirm that playback has been repaired or that an affected task can be evaluated.\"}, {\"evidence_id\": \"k:audio-multimodal-faq@1.1:f72aa6db\", \"origin\": \"retrieved_source\", \"use\": \"CURRENT_GUIDANCE\", \"citation\": {\"authoring\": \"audio-multimodal-faq@1.1\", \"title\": \"Audio Multimodal — FAQ (v1.1)\", \"sections\": [\"Language and TTS\"], \"source\": {\"manual_key\": \"audio-multimodal-faq\", \"system\": \"manual\"}}, \"source_type\": \"faq\", \"record_kind\": \"faq\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\"}, \"dates\": {\"source_date\": \"2026-09-20T13:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-09-20T13:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"audio_multimodal\", \"scope\": \"project\", \"batch_relation\": \"project_wide\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U006\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"approved\"}, \"excerpt\": \"## Language and TTS\\n\\n### Q: The generated speech is in the wrong language. Is that a playback failure?\\nConfirm the requested language and permitted switching. If the recording itself contains an unrequested language mismatch, record it as a language-quality issue rather than a playback fai