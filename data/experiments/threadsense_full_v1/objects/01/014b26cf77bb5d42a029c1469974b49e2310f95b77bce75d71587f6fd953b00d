"rubric\": {\"version\": \"severity-rubric-v3-semantic-signals\", \"scope\": \"SHARED_DEFAULT\", \"levels\": {\"HIGH\": {\"definition\": \"Issue creating or reasonably indicating a serious risk to data integrity, labeling quality, operational continuity, or required safety procedures. May affect many tasks, cause difficult-to-reverse errors, or require prompt escalation. Serious impact may be inferred from the described behavior even when it is not explicitly stated.\", \"examples\": \"Widespread incorrect labeling caused by conflicting instructions; required QN/safety controls being bypassed; major LT outage; systemic QA misalignment affecting a batch; Operational reports such as 'all required fields are filled but Submit stays grey' or 'the waveform loads but Play never starts' can indicate inability to complete or evaluate assigned work.\", \"signals\": [{\"index\": 0, \"text\": \"Explicit statement that assigned work cannot be completed or evaluated\"}, {\"index\": 1, \"text\": \"Safety or required QN control described as bypassed, missing, or ignored\"}, {\"index\": 2, \"text\": \"Issue reported as affecting many tasks or an entire batch\"}, {\"index\": 3, \"text\": \"Multiple distinct people or affected tasks reporting a comparable problem within the relevant project, batch, and time window, suggesting broader disruption or systemic labeling risk. Consider the number affected relative to the known active group when that information is available; do not require an explicit statement of widespread impact\"}]}, \"MEDIUM\": {\"definition\": \"Issue that may affect labeling accuracy, QA consistency, or operational efficiency, requiring clarification or intervention. Impact appears meaningful but contained or manageable based on the available context. A question alone does not establish MEDIUM, but its content may reveal consequential uncertainty.\", \"examples\": \"Recurring rubric ambiguity; conflicting QA interpretations; intermittent LT failures affecting task completion; unclear QN handling for a specific edge case. Examples include similar pairs receiving inconsistent tie judgments, reviewers disagreeing over clipping severity, or playback repeatedly failing and then recovering.\", \"signals\": [{\"index\": 0, \"text\": \"Recurring confusion about the same rule, tool behavior, or scoring criterion that suggests meaningful workflow or labeling impact\"}, {\"index\": 1, \"text\": \"Conflicting interpretations that affect, or are reasonably likely to affect, how tasks are scored or handled\"}, {\"index\": 2, \"text\": \"Intermittent or contained tool/process failure suggesting a meaningful interruption, with context indicating that work remains possible or access recovers\"}]}, \"LOW\": {\"definition\": \"Localized issue that appears to have limited impact on labeling quality or workflow. The available context suggests a minor inconvenience or straightforward correction rather than a substantive operational problem.\", \"examples\": \"One-off clarification of otherwise clear guidance; minor LT inconvenience; isolated inconsistency with little downstream impact; a confusing FAQ heading when the underlying rule is understood and usable.\", \"signals\": []}, \"N/A\": {\"definition\": \"No identifiable operational problem or risk requiring severity assessment. Includes casual chat, pure social threads, and routine announcements.\", \"examples\": \"Routine announcements, informational updates, acknowledgments, administrative messages, general discussion without an actionable issue.\", \"signals\": []}, \"UNKNOWN\": {\"definition\": \"The report and available context are too ambiguous or incomplete to meaningfully assess operational impact. Missing explicit impact wording, affected-task counts, or a confirmed technical cause does not by itself require UNKNOWN.\", \"examples\": \"'Something looks wrong' without describing the behavior; a report referring to missing context; contradictory accounts that leave it unclear whether there is a minor display issue or an inability to complete the task.\", \"signals\": []}}}, \"limits\": {\"follow_up_queries\": 3}, \"previous_draft\": {\"contract_version\": \"agent3-advisor-draft-v11\", \"summary\": \"Two QA tutors and four tutors report LT submission problems, including disabled Submit controls, a return to the rating screen, and missing confirmation. Submission remains unverified in two threads; the team lead has answered a separate tutor's question about handling a saved rating without confirmed completion.\", \"summary_sentences\": [{\"text\": \"Two QA tutors and four tutors report LT submission problems, including disabled Submit controls, a return to the rating screen, and missing confirmation.\", \"support_claim_ids\": [\"c1\", \"c2\", \"c3\", \"c4\", \"c5\"], \"depends_on\": []}, {\"text\": \"Submission remains unverified in two threads; the team lead has answered a separate tutor's question about handling a saved rating without confirmed completion.\", \"support_claim_ids\": [\"c7\", \"c8\"], \"depends_on\": []}], \"detail_sentences\": [{\"text\": \"A QA tutor reports that LT will not submit the Korean language review after rating selection; an engineer identifies the task as MULTI-3198.\", \"support_claim_ids\": [\"c1\", \"c6\"], \"depends_on\": [], \"summary_depends_on\": []}, {\"text\": \"Two tutors in the same thread report that Submit remains disabled despite completing every field.\", \"support_claim_ids\": [\"c2\"], \"depends_on\": [], \"summary_depends_on\": []}, {\"text\": \"A QA tutor reports that submitting the Spanish evaluation on MULTI-2163 returns to the rating screen; a tutor in that thread reports no submission confirmation after selecting B.\", \"support_claim_ids\": [\"c3\", \"c4\"], \"depends_on\": [], \"summary_depends_on\": []}, {\"text\": \"A tutor asks QA how to handle a multilingual review that cannot be finalized even though the rating saved.\", \"support_claim_ids\": [\"c5\"], \"depends_on\": [], \"summary_depends_o