sis\": \"created_at\", \"created_at\": \"2026-10-02T10:21:53.000019+00:00\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"response_preference\", \"batch_id\": \"rp_batch_15\", \"scope\": \"project\", \"batch_relation\": \"same_batch\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U001\", \"actor_relation\": \"MESSAGE_AUTHOR\", \"approval_status\": \"UNKNOWN\"}, \"authorship\": {\"author_id\": \"U001\", \"verified\": true, \"basis\": \"SLACK_MESSAGE_AUTHOR\"}, \"excerpt\": \"[ANNOUNCEMENT posted 2026-10-02T10:21:53.000019+00:00 by TEAM_LEAD (rp_batch_15): not established as handling for this topic until you show it is relevant and gives a directive.]\\nBatch status note — Competing rubric dimensions: factuality versus instruction adherence. Please keep examples in this thread while we check the scope.\\n\\nContext reply [1790936562.000113] by U007 (QA_TUTOR):\\nWas the requested structure mandatory, and were the factual statements correct independently?\\n\\nContext reply [1790936607.000226] by U001 (TEAM_LEAD):\\nPlease paste the exact formatting instruction; QA needs to verify whether it was mandatory before weighing the responses.\"}, {\"evidence_id\": \"k:response-preference-instructions@1.1:a71c54c7\", \"origin\": \"retrieved_source\", \"use\": \"CURRENT_GUIDANCE\", \"citation\": {\"authoring\": \"response-preference-instructions@1.1\", \"title\": \"Response Preference — Instructions (v1.1)\", \"sections\": [\"Content-quality rubric\"], \"source\": {\"manual_key\": \"response-preference-instructions\", \"system\": \"manual\"}}, \"source_type\": \"guideline\", \"record_kind\": \"guideline\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\"}, \"dates\": {\"source_date\": \"2026-08-30T13:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-08-30T13:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"response_preference\", \"scope\": \"project\", \"batch_relation\": \"project_wide\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U001\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"approved\"}, \"excerpt\": \"## Content-quality rubric\\nMajor/minor describe task-quality defects and do not determine operational incident severity.\\n\\n| Dimension | Major defect | Minor defect | Acceptable / no automatic penalty |\\n| --- | --- | --- | --- |\\n| Factual accuracy | Error changes the central conclusion or actionable answer | Nonessential background error without that effect | Accurate paraphrase or an immaterial stylistic difference |\\n| Instruction adherence | Explicit required format/structure is missing | Limited violation of an actual secondary requirement | A stylistic choice that violates no requirement |\\n| Citation support | Fabricated reference or materially unsupported attribution | A limited citation-detail error where the source and support remain identifiable | A valid source that supports the claim |\\n| Preference | Identify a meaningful benefit; grade underlying defects separately | Do not manufacture a defect to break a tie | No meaningful quality difference supports a tie |\\n\\nAn inaccessible link needs a verification note; lack of access alone does not establish the error grade of the claim.\"}, {\"evidence_id\": \"k:response-preference-instructions@1.1:47ed0c14\", \"origin\": \"retrieved_source\", \"use\": \"CURRENT_GUIDANCE\", \"citation\": {\"authoring\": \"response-preference-instructions@1.1\", \"title\": \"Response Preference — Instructions (v1.1)\", \"sections\": [\"Instruction adherence versus accuracy\"], \"source\": {\"manual_key\": \"response-preference-instructions\", \"system\": \"manual\"}}, \"source_type\": \"guideline\", \"record_kind\": \"guideline\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\"}, \"dates\": {\"source_date\": \"2026-08-30T13:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-08-30T13:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"response_preference\", \"scope\": \"project\", \"batch_relation\": \"project_wide\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U001\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"approved\"}, \"excerpt\": \"## Instruction adherence versus accuracy\\nScore these dimensions separately. An explicit required output structure, such as JSON, is not optional.\\n\\nThis guidance does not define a universal preference ordering for a response that is stronger on accuracy but weaker on a required format. When the applicable rules and actual pair do not settle the comparison, provide the exact prompt, both responses and their separate defects for a TL decision. Do not assume facts about the other response.\"}, {\"evidence_id\": \"k:response-preference-instructions@1.1:3350bbc0\", \"origin\": \"retrieved_source\", \"use\": \"CURRENT_GUIDANCE\", \"citation\": {\"authoring\": \"response-preference-instructions@1.1\", \"title\": \"Response Preference — Instructions (v1.1)\", \"sections\": [\"Factual errors and citations\"], \"source\": {\"manual_key\": \"response-preference-instructions\", \"system\": \"manual\"}}, \"source_type\": \"guideline\", \"record_kind\": \"guideline\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\"}, \"dates\": {\"source_date\": \"2026-08-30T13:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-08-30T13:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"response_preference\", \"scope\": \"project\", \"batch_relation\": \"project_wide\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U001\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"approved\"}, \"excerpt\": \"## Factual errors and citations\\n- A factual error is major when it changes the central conclusion or the answer a user would act on.\\n- A nonessential background error with no effect on that conclusion is minor.\\n- A broken link is an access/verification failure, not proof that the underlying factual claim is false.\\n- Distinguish an existing source that does not support the claim from an invented reference.\"}, {\"evidence_id\": \"k:response-preference-faq@1.1:3db12f63\", \"origin\": \"retrieved_source\", \"use\": \"CURRENT_GUIDANCE\", \"citation\": {\"authoring\": \"response-preference-faq@1.1\", \"title\": \"Response Preference — FAQ (v1.1)\", \"sections\": [\"Factual errors\"], \"source\": {\"manual_key\": \"response-preference-faq\", \"system\": \"manual\"}}, \"source_type\": \"faq\", \"record_kind\": \"faq\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\"}, \"dates\": {\"source_date\": \"2026-09-05T13:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-09-05T13:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"response_preference\", \"scope\": \"project\", \"batch_relation\": \"project_wide\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U001\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"approved\"}, \"excerpt\": \"## Factual errors\\n\\n### Q: What counts as a significant factual error?