\"NONE\"}, {\"evidence_id\": \"m:C_MULTI_GENERAL:1790932874.000113\", \"origin\": \"member_message\", \"use\": \"MEMBER_REPORT\", \"member_id\": \"member_af8271311d00e91da422309c\", \"thread_id\": \"1790932821.000177\", \"author_id\": \"U019\", \"author_role\": \"QA_TUTOR\", \"timestamp\": \"2026-10-02T09:21:14.000113Z\", \"thread_starter_id\": \"U009\", \"thread_starter_role\": \"TUTOR\", \"reactions\": [{\"name\": \"thumbsup\", \"users\": [\"U017\"]}], \"excerpt\": \"What locale and audience were specified for this task?\", \"instruction_authority\": \"NONE\"}, {\"evidence_id\": \"m:C_MULTI_GENERAL:1790932912.000226\", \"origin\": \"member_message\", \"use\": \"MEMBER_REPORT\", \"member_id\": \"member_af8271311d00e91da422309c\", \"thread_id\": \"1790932821.000177\", \"author_id\": \"U001\", \"author_role\": \"TEAM_LEAD\", \"timestamp\": \"2026-10-02T09:21:52.000226Z\", \"thread_starter_id\": \"U009\", \"thread_starter_role\": \"TUTOR\", \"excerpt\": \"Language QA needs the target locale and both explanations before we declare one interpretation authoritative.\", \"instruction_authority\": \"THREAD_SCOPE\"}], \"retrieved_sources\": [{\"evidence_id\": \"k:multilingual-eval-instructions@1.2:db772378\", \"origin\": \"retrieved_source\", \"use\": \"CURRENT_GUIDANCE\", \"citation\": {\"authoring\": \"multilingual-eval-instructions@1.2\", \"title\": \"Multilingual Evaluation — Instructions (v1.2)\", \"sections\": [\"Content-quality rubric\"], \"source\": {\"manual_key\": \"multilingual-eval-instructions\", \"system\": \"manual\"}}, \"source_type\": \"guideline\", \"record_kind\": \"guideline\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\"}, \"dates\": {\"source_date\": \"2026-09-10T13:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-09-10T13:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"multilingual_eval\", \"scope\": \"project\", \"batch_relation\": \"project_wide\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U001\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"approved\"}, \"excerpt\": \"## Content-quality rubric\\nThese grades concern task-quality defects. Language QA must establish context and impact for disputed locale-specific cases.\\n\\n| Dimension | Major defect | Minor defect | Acceptable / no automatic penalty |\\n| --- | --- | --- | --- |\\n| Language adherence | Substantial unrequested language mismatch violating the requirement | Limited genuine mismatch with a stated requirement | Ordinary loanwords or switching permitted by the task |\\n| Register / honorifics | Unmotivated, materially disruptive inconsistency confirmed in context | Localized inappropriate shift with limited effect | Natural variation, quotation or a justified addressee change |\\n| Regional appropriateness | Clear material mismatch with the specified audience | Localized genuine mismatch with limited effect | Regional vocabulary natural for the intended audience |\\n| Naturalness | Demonstrable phrasing problems that materially impair meaning or appropriate use | Identifiable localized awkwardness | A reviewer preference without an identifiable error |\"}, {\"evidence_id\": \"k:multi-spanish-audit-schedule-approval@1.0:bba64f57\", \"origin\": \"retrieved_source\", \"use\": \"PRIOR_DECISION\", \"citation\": {\"authoring\": \"multi-spanish-audit-schedule-approval@1.0\", \"title\": \"Approve a small Spanish audit slot\", \"sections\": [\"Evidence available at review\", \"Prior ThreadSense advice\", \"TL response\"], \"source\": {\"manual_key\": \"multi-spanish-audit-schedule-approval\", \"system\": \"manual\"}}, \"source_type\": \"decision\", \"record_kind\": \"advice_review\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\", \"enactment\": {\"status\": \"NOT_ENACTED\", \"missing\": [\"NOT_A_POLICY_CHANGE\", \"NO_ENACTMENT_EVIDENCE\"]}}, \"dates\": {\"source_date\": \"2026-09-21T16:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-09-21T16:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"multilingual_eval\", \"batch_id\": \"multi_batch_11\", \"scope\": \"project\", \"batch_relation\": \"same_batch\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U001\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"tl_approved\", \"decision_status\": \"tl_approved\", \"execution_status\": \"pending_scheduling\", \"outcome_status\": \"not_observed\"}, \"excerpt\": \"[PRIOR RECORD (advice_review; decision_status: tl_approved; execution_status: pending_scheduling; outcome_status: not_observed) - history, not a standing rule.]\\n# Approve a small Spanish audit slot\\n\\n## Evidence available at review\\n\\nThe weekly coordination log shows twelve Spanish tasks awaiting routine second review. Leo (U007, Spanish QA) offered a 30-minute slot on September 23. This was a scheduling backlog, with no recorded claim of widespread incorrect scoring or a new language defect.\\n\\nThe requested sample is ten tasks, selected across the participating tutors; the remaining two stay in the normal audit queue. Selection and the calendar booking are not yet recorded. Completion of this review does not certify the whole batch.\\n\\n## Prior ThreadSense advice\\n\\nBook Leo for a 30-minute Spanish audit discussion and assemble a ten-task sample from the September 18 queue, retaining the reviewer rationales.\\n\\n## TL response\\n\\nApproved. Use the offered September 23 slot after Leo confirms the booking. Sample across tutors rather than choosing only disagreements. Record which ten tasks were reviewed and leave the other two visible in the queue. This is routine audit coverage, not a change to scoring guidance.\"}, {\"evidence_id\": \"k:multilingual-eval-instructions@1.2:b26ca59b\", \"origin\": \"retrieved_source\", \"use\": \"CURRENT_GUIDANCE\", \"citation\": {\"authoring\": \"multilingual-eval-instructions@1.2\", \"title\": \"Multilingual Evaluation — Instructions (v1.2)\", \"sections\": [\"Regional variation and naturalness\"], \"source\": {\"manual_key\": \"multilingual-eval-instructions\", \"system\": \"manual\"}}, \"source_type\": \"guideline\", \"record_kind\": \"guideline\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\"}, \"dates\": {\"source_date\": \"2026-09-10T13:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-09-10T13:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"multilingual_eval\", \"scope\": \"project\", \"batch_relation\": \"project_wide\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U001\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"approved\"}, \"excerpt\": \"## Regional variation and naturalness\\nAssess wording against the specified locale or audience. Natural Southern Vietnamese vocabulary is not an error merely because a Northern reviewer prefers a different word. Reviewer preference or a majority vote alone does not establish a linguistic defect; identify the wording and its effect.\"}, {\"evidence_id\": \"k:multi-audit-filename-convention-approval@1.0:a5a80940\", \"origin\": \"retrieved_source\", \"use\": \"PRIOR_DECISION\", \"citation\": {\"authoring\": \"multi-audit-filename-convention-approval@1.0\", \"title\": \"Approve English field names for the audit index\", \"sections\": [\"Evidence available at review\", \"Prior ThreadSense advice\", \"TL response\"], \"source\": {\"manual_key\": \"multi-audit-filename-convention-approval\", \"system\": \"manual\"}}, \"source_type\": \"decision\", \"record_kind\": \"advice_review\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\", \"enactment\": {\"status\": \"NOT_ENACTED\", \"missing\": [\"NOT_A_POLICY_CHANGE\", \"NO_ENACTMENT_EVIDENCE\"]}}, \"dates\": {\"source_date\": \"2026-09-29T16:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-09-29T16:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"multilingual_eval\", \"batch_id\": \"multi_batch_11\", \"scope\": \"project\", \"batch_relation\": \"same_batch\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U001\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"tl_approved\", \"decision_status\": \"tl_approved\", \"execution_status\": \"not_executed\", \"outcome_status\": \"not_observed\"}, \"excerpt\": \"[PRIOR RECORD (advice_review; decision_status: tl_approved; execution_status: not_executed; outcome_status: not_observed) - history, not a standing rule.]\\n# Approve English field names for the audit index\\n\\n## Evidence available at review\\n\\nThe September 28 audit packet used mixed headings for the same metadata field: task_id, ID de tarea, and タスクID. The review coordinator manually matched three equivalent columns. The packet also included original Spanish and Japanese text excerpts; no defect in those excerpts was alleged.\\n\\nThe proposed index convention uses English metadata keys task_id, locale, and reviewer_id, with attachment names multi11_<locale>_<task_id>.txt. Only the administrative labels and filenames would change. No index revision has been published yet.\\n\\n## Prior ThreadSense advice\\n\\nUse English throughout audit packets so cross-language reviewers can navigate them consistently.\\n\\n## TL response\\n\\nApprove a narrower documentation edit: English keys and predictable filenames for the internal audit index. Preserve original-language prompts, responses, and quoted evidence. Do not translate the evaluated content or treat an English index field as evidence that a model switched languages.\"}, {\"evidence_id\": \"k:multi-korean-referral@1.0:929d7cee\", \"origin\": \"retrieved_source\", \"use\": \"PRIOR_DECISION\", \"citation\": {\"authoring\": \"multi-korean-referral@1.0\", \"title\": \"Korean register case referred to language QA\", \"sections\": [\"Request\", \"TL decision\", \"Requested assessment\", \"Scope\"], \"source\": {\"manual_key\": \"multi-korean-referral\", \"system\": \"manual\"}}, \"source_type\": \"decision\", \"record_kind\": \"expert_referral\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\", \"enactment\": {\"status\": \"NOT_ENACTED\", \"missing\": [\"OUT_OF_SCOPE\", \"NOT_A_POLICY_CHANGE\", \"NO_ENACTMENT_EVIDENCE\"]}}, \"dates\": {\"source_date\": \"2026-09-12T14:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-09-12T14:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"multilingual_eval\", \"batch_id\": \"multi_batch_10\", \"scope\": \"project\", \"batch_relation\": \"other_batch\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U001\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"tl_approved\", \"decision_status\": \"tl_approved\", \"execution_status\": \"routed\", \"outcome_status\": \"pending_expert_review\"}, \"excerpt\": \"[PRIOR RECORD (expert_referral; decision_status: tl_approved; execution_status: routed; outcome_status: pending_expert_review) - history, not a standing rule.]\\n# Korean register case referred to language QA\\n\\n## Request\\nM10-KO-017 contains a polite narrative followed by a casual sentence inside quotation marks. The packet did not identify whether the quoted speaker and addressee changed.\\n\\n## TL decision\\nAlex routed the case to Hana (U008), whose recorded specialty is Korean, with the exact endings and surrounding paragraph. Do not assign a major register penalty from the ending change alone.\\n\\n## Requested assessment\\nEstablish who is speaking, whether the quote is intentional, and whether the language remains appropriate for the intended audience. The original scoring question stays open until that context is reviewed.\\n\\n## Scope\\nThis referral concerns M10-KO-017 in batch 10. It is not a general exemption for Korean register shifts.\"}, {\"evidence_id\": \"k:multilingual-eval-faq@1.1:c080929d\", \"origin\": \"retrieved_source\", \"use\": \"CURRENT_GUIDANCE\", \"citation\": {\"authoring\": \"multilingual-eval-faq@1.1\", \"title\": \"Multilingual Evaluation — FAQ (v1.1)\", \"sections\": [\"Register and honorifics\"], \"source\": {\"manual_key\": \"multilingual-eval-faq\", \"system\": \"manual\"}}, \"source_type\": \"faq\", \"record_kind\": \"faq\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\"}, \"dates\": {\"source_date\": \"2026-09-18T13:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-09-18T13:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"multilingual_eval\", \"scope\": \"project\", \"batch_relation\": \"project_wide\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U001\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"approved\"}, \"excerpt\": \"[ADDED FOR TYPE COVERAGE: best-ranked faq for this query (rank 7), outside the top 5.]\\n## Register and honorifics\\n\\n### Q: Who scores Korean or Japanese register shifts?\\nRoute the case to appropriate Korean or Japanese language QA with exact sentence endings and surrounding context. Check quotations and addressee changes. The task-quality grade depends on demonstrated impact; do not assign a major penalty from the presence of a shift alone.\\n\\n### Q: Spanish tú versus usted inconsistency — major or minor?\\nAsk Spanish QA to check addressee, intended formality and discourse context. An unjustified shift can be an error, but its grade needs a case-specific rationale.\", \"retrieved_as\": {\"role\": \"TYPE_COVERAGE\", \"detail\": \"best-ranked faq for this query (rank 7), outside the top 5\"}}, {\"evidence_id\": \"k:multi-korean-scoped-result@1.0:5b489480\", \"origin\": \"retrieved_source\", \"use\": \"PRIOR_DECISION\", \"citation\": {\"authoring\": \"multi-korean-scoped-result@1.0\", \"title\": \"Scoped Korean finding confirmed by the TL\", \"sections\": [\"Specialist finding\", \"TL confirmation\", \"Result and limits\"], \"source\": {\"manual_key\": \"multi-korean-scoped-result\", \"system\": \"manual\"}}, \"source_type\": \"decision\", \"record_kind\": \"expert_review\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"history\", \"enactment\": {\"status\": \"NOT_ENACTED\", \"missing\": [\"OUT_OF_SCOPE\", \"NOT_A_POLICY_CHANGE\", \"NO_ENACTMENT_EVIDENCE\"]}}, \"dates\": {\"source_date\": \"2026-09-14T15:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-09-14T15:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"multilingual_eval\", \"batch_id\": \"multi_batch_10\", \"scope\": \"project\", \"batch_relation\": \"other_batch\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U001\", \"actor_relation\": \"RECORD_