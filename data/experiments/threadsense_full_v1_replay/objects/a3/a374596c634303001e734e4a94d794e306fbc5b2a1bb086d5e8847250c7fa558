, \"instruction_authority\": \"NONE\"}], \"retrieved_sources\": [{\"evidence_id\": \"k:audio-multimodal-instructions@1.3:1c6df70e\", \"origin\": \"retrieved_source\", \"use\": \"CURRENT_GUIDANCE\", \"citation\": {\"authoring\": \"audio-multimodal-instructions@1.3\", \"title\": \"Audio Multimodal — Instructions (v1.3)\", \"sections\": [\"Playback and unavailable content\"], \"source\": {\"manual_key\": \"audio-multimodal-instructions\", \"system\": \"manual\"}}, \"source_type\": \"guideline\", \"record_kind\": \"guideline\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\"}, \"dates\": {\"source_date\": \"2026-09-15T13:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-09-15T13:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"audio_multimodal\", \"scope\": \"project\", \"batch_relation\": \"project_wide\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U006\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"approved\"}, \"excerpt\": \"## Playback and unavailable content\\n- If the player fails to load or start, report a tool incident with the task ID.\\n- A visible waveform with no playback is still a playback/tool incident; the waveform alone does not establish that the recording is silent.\\n- Do not score unavailable audio as a model-quality failure or make a content-based Quarantine (QN) decision solely because playback is unavailable.\\n- Capture the browser/error state and whether another clip plays. An old workaround must be checked against the current symptoms; recurrence alone does not establish which fix was tried or why it failed.\\n- Handling guidance does not confirm that playback has been repaired or that an affected task can be evaluated.\"}, {\"evidence_id\": \