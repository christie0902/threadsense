mp\": \"2026-10-02T06:24:25.000226Z\", \"thread_starter_id\": \"U008\", \"thread_starter_role\": \"QA_TUTOR\", \"excerpt\": \"Are any required rating fields still unset, or is the submit control disabled after completing them? A successful reload is not proof that the original task was submitted.\", \"instruction_authority\": \"NONE\"}, {\"evidence_id\": \"m:C_MULTI_GENERAL:1790934407.000170\", \"origin\": \"member_message\", \"use\": \"MEMBER_REPORT\", \"member_id\": \"member_a0e8e21fd079b3167031c525\", \"thread_id\": \"1790934407.000170\", \"author_id\": \"U017\", \"author_role\": \"TUTOR\", \"timestamp\": \"2026-10-02T09:46:47.000170Z\", \"thread_starter_id\": \"U017\", \"thread_starter_role\": \"TUTOR\", \"excerpt\": \"Could QA clarify this case: Cannot finalize this multilingual review even though the rating saved.\", \"instruction_authority\": \"NONE\"}, {\"evidence_id\": \"m:C_MULTI_GENERAL:1790934465.000113\", \"origin\": \"member_message\", \"use\": \"MEMBER_REPORT\", \"member_id\": \"member_a0e8e21fd079b3167031c525\", \"thread_id\": \"1790934407.000170\", \"author_id\": \"U001\", \"author_role\": \"TEAM_LEAD\", \"timestamp\": \"2026-10-02T09:47:45.000113Z\", \"thread_starter_id\": \"U017\", \"thread_starter_role\": \"TUTOR\", \"excerpt\": \"For this affected task, selecting a rating or label is not proof of submission. Keep the task reference and flag the LT submission failure; do not count it complete without confirmation.\", \"instruction_authority\": \"THREAD_SCOPE\"}], \"retrieved_sources\": [{\"evidence_id\": \"k:multilingual-eval-instructions@1.2:ea925467\", \"origin\": \"retrieved_source\", \"use\": \"CURRENT_GUIDANCE\", \"citation\": {\"authoring\": \"multilingual-eval-instructions@1.2\", \"title\": \"Multilingual Evaluation — Instructions (v1.2)\", \"sections\": [\"Tool incidents and submission\"], \"source\": {\"manual_key\": \"multilingual-eval-instructions\", \"system\": \"manual\"}}, \"source_type\": \"guideline\", \"record_kind\": \"guideline\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\"}, \"dates\": {\"source_date\": \"2026-09-10T13:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-09-10T13:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"multilingual_eval\", \"scope\": \"project\", \"batch_relation\": \"project_wide\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U001\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"approved\"}, \"excerpt\": \"## Tool incidents and submission\\nBoxes, missing diacritics or broken characters in LT are tool-rendering incidents until the source text is checked. Compare outside the tool where possible. If unavailable, record the limitation rather than asserting that the model produced corrupt text.\\n\\nCapture task IDs for rendering or submission failures. Treat tool impact under the operational incident rubric, separately from language-quality grades. A saved rating is not proof of a completed submission.\"}, {\"evidence_id\": \"k:multilingual-eval-faq@1.1:8508b653\", \"origin\": \"retrieved_source\", \"use\": \"CURRENT_GUIDANCE\", \"citation\": {\"authoring\": \"multilingual-eval-faq@1.1\", \"title\": \"Multilingual Evaluation — FAQ (v1.1)\", \"sections\": [\"Language adherence\"], \"source\": {\"manual_key\": \"multilingual-eval-faq\", \"system\": \"manual\"}}, \"source_type\": \"faq\", \"record_kind\": \"faq\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\"}, \"dates\": {\"source_date\": \"2026-09-18T13:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-09-18T13:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"multilingual_eval\", \"scope\": \"project\", \"batch_relation\": \"project_wide\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U001\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"approved\"}, \"excerpt\": \"## Language adherence\\n\\n### Q: Does a single English word in a Korean or Japanese answer count as code-switching?\\nNot automatically. Ordinary loanwords are acceptable. Assess the word in context and against the required output language; an unrequested full paragraph in another language is a different issue.\\n\\n### Q: The user code-switched. Should the response mirror it?\\nCheck the explicit output-language requirement and context. User code-switching alone does not settle the score.\"}, {\"evidence_id\": \"k:multilingual-eval-faq@1.1:c080929d\", \"origin\": \"retrieved_source\", \"use\": \"CURRENT_GUIDANCE\", \"citation\": {\"authoring\": \"multilingual-eval-faq@1.1\", \"title\": \"Multilingual Evaluation — FAQ (v1.1)\", \"sections\": [\"Register and honorifics\"], \"source\": {\"manual_key\": \"multilingual-eval-faq\", \"system\": \"manual\"}}, \"source_type\": \"faq\", \"record_kind\": \"faq\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\"}, \"dates\": {\"source_date\": \"2026-09-18T13:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-09-18T13:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"multilingual_eval\", \"scope\": \"project\", \"batch_relation\": \"project_wide\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U001\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"approved\"}, \"excerpt\": \"## Register a