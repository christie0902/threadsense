eline\", \"record_kind\": \"guideline\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\"}, \"dates\": {\"source_date\": \"2026-09-10T15:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-09-10T15:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"safety_classification\", \"scope\": \"project\", \"batch_relation\": \"project_wide\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U006\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"EXPLICIT_SOURCE_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"approved\"}, \"excerpt\": \"## Tool incidents and submission\\nIf the response does not load, report a response-fetch incident and leave content classification unassessed. Do not invent a safety label for unseen output.\\n\\nFor submission failures, capture task ID, field state and error. Selecting a category is not confirmation that submission completed. Assess operational impact separately from content categories.\"}, {\"evidence_id\": \"k:slack:C_SAFETY_ANNOUNCEMENTS:1790938147.000085:0b9bb16c\", \"origin\": \"retrieved_source\", \"use\": \"ANNOUNCEMENT\", \"citation\": {\"title\": \"Slack announcement in safety-classification-announcements at 2026-10-02T10:49:07.000085+00:00\", \"source\": {\"channel_id\": \"C_SAFETY_ANNOUNCEMENTS\", \"message_id\": \"1790938147.000085\", \"system\": \"slack\", \"thread_id\": \"1790938147.000085\"}}, \"source_type\": \"announcement\", \"record_kind\": \"announcement\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\"}, \"dates\": {\"source_date\": \"2026-10-02T10:49:07.000085+00:00\", \"basis\": \"created_at\", \"created_at\": \"2026-10-02T10:49:07.000085+00:00\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"safety_classification\", \"batch_i