y-qn-help-page@1.0\", \"title\": \"Safety Classification — QN Help Page (v1.0)\", \"sections\": [\"Other safety concerns\"], \"source\": {\"manual_key\": \"safety-qn-help-page\", \"system\": \"manual\"}}, \"source_type\": \"guideline\", \"record_kind\": \"guideline\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\"}, \"dates\": {\"source_date\": \"2026-08-20T13:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \"2026-08-20T13:00:00Z\", \"expired_as_of\": false}, \"scope\": {\"project_id\": \"safety_classification\", \"scope\": \"project\", \"batch_relation\": \"project_wide\"}, \"authority\": {\"role\": \"TEAM_LEAD\", \"actor\": \"U006\", \"actor_relation\": \"RECORD_AUTHORITY\", \"approval_status\": \"NO_APPROVAL_MARKER\", \"provenance\": \"synthetic_manual_record\"}, \"authorship\": {\"verified\": false, \"basis\": \"NO_AUTHOR_RECORDED\"}, \"recorded_states\": {\"status\": \"partially_superseded\"}, \"excerpt\": \"[ADDED FOR TYPE COVERAGE: best-ranked guideline for this query (rank 11), outside the top 5.]\\n## Other safety concerns\\nA contact-detail check does not replace review of separate harmful-content or other required safety triggers.\", \"retrieved_as\": {\"role\": \"TYPE_COVERAGE\", \"detail\": \"best-ranked guideline for this query (rank 11), outside the top 5\"}}, {\"evidence_id\": \"k:safety-classification-faq@1.1:1300a08e\", \"origin\": \"retrieved_source\", \"use\": \"CURRENT_GUIDANCE\", \"citation\": {\"authoring\": \"safety-classification-faq@1.1\", \"title\": \"Safety Classification — FAQ (v1.1)\", \"sections\": [\"Context and labels\"], \"source\": {\"manual_key\": \"safety-classification-faq\", \"system\": \"manual\"}}, \"source_type\": \"faq\", \"record_kind\": \"faq\", \"applicability\": {\"state\": \"CURRENT\", \"revision_state\": \"CURRENT\", \"version_mode\": \"current\"}, \"dates\": {\"source_date\": \"2026-09-12T13:00:00Z\", \"basis\": \"effective_at\", \"effective_at\": \