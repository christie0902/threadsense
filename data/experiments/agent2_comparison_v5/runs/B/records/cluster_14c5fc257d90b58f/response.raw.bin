        "content": "{\"topics\":[{\"topic_name\":\"LT submit control prevents completing preference-labeling tasks\",\"member_ids\":[\"M01\",\"M02\",\"M03\",\"M04\",\"M05\"],\"shared_issue\":{\"text\":\"Across these threads, members report that after completing preference-labeling selections or rubric fields in LT, the submit control does not complete submission, with examples including a disabled button and clicks that do nothing.\",\"evidence_ids\":[\"E001\",\"E002\",\"E003\",\"E007\",\"E010\",\"E014\",\"E015\"]},\"relevant_differences\":[{\"text\":\"Some reports describe the Submit button as remaining disabled/grey after selections or completed rubric fields.\",\"evidence_ids\":[\"E002\",\"E003\",\"E010\",\"E015\"]},{\"text\":\"Another report says clicking Submit does nothing rather than describing a disabled button.\",\"evidence_ids\":[\"E007\"]},{\"text\":\"One announcement says the issue was seen across projects, while several thread replies say the wider cause or submission status was still unverified in those specific cases.\",\"evidence_ids\":[\"E001\",\"E005\",\"E006\",\"E009\",\"E012\",\"E013\",\"E017\"]}],\"inventory\":[{\"item_id\":\"I001\",\"evidence_id\":\"E001\",\"kind\":\"ANNOUNCEMENT\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I002\",\"evidence_id\":\"E001\",\"kind\":\"INSTRUCTION\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I003\",\"evidence_id\":\"E002\",\"kind\":\"FACT\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I004\",\"evidence_id\":\"E003\",\"kind\":\"FACT\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I005\",\"evidence_id\":\"E004\",\"kind\":\"DIAGNOSTIC_REQUEST\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I006\",\"evidence_id\":\"E005\",\"kind\":\"INSTRUCTION\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I007\",\"evidence_id\":\"E006\",\"kind\":\"INSTRUCTION\",\"answer_status\":null,\"question\":null},{\"item_id\":\"I008\",\"evidence_id\":\"E007\",\"kind\":\"