    "test:demo": "playwright test --config playwright.demo.config.js",
    "test:unit": "node --test \"unit/**/*.test.js\""
  },
  "dependencies": {
    "framer-motion": "11.18.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.27",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.19",
    "vite": "5.4.21"
  }
}
