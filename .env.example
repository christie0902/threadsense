# Copy to .env in the project root. Both agents load it automatically.
# Paste your OpenAI API key after the equals sign below.
OPENAI_API_KEY=
THREADSENSE_MODEL=openai/gpt-4o-mini

# Optional: to use OpenRouter instead, change THREADSENSE_MODEL to
# openrouter/openrouter/free and fill in OPENROUTER_API_KEY.
OPENROUTER_API_KEY=
